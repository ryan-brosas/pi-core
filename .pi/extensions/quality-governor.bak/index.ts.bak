import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

import {
  canDispatchRepair,
  classifyRequest,
  confirmContract,
  decideAdmission,
  parseContractCandidate,
  reduceQualityVector,
  revokeContract,
  reviseContract,
  selectGate,
  type AdmissionDecision,
  type ConfirmedContract,
  type ContractCandidate,
  type GateState,
  type GovernorMode,
  type QualityVector,
  type VerificationState,
  type ViolationCode,
} from "./policy.ts";
import {
  canonicalizeTarget,
  collectDiffEvidence,
  fingerprintRepository,
  loadGovernorConfig,
  resolveCheckRecipe,
  runCheckRecipe,
  validateReceiptFreshness,
  type CheckReceipt,
  type CheckRecipe,
  type DiffEvidence,
  type GovernorConfig,
} from "./sensors.ts";

const ENTRY_TYPE = "quality-governor/v1";
const STATUS_KEY = "quality-governor";
const WIDGET_KEY = "quality-governor-detail";
const GOVERNOR_TOOLS = new Set(["quality_contract", "quality_status", "quality_check"]);
const MODES = new Set<GovernorMode>(["PLAN", "BUILD", "VERIFY"]);
const GATES = new Set<GateState>(["GREEN", "YELLOW", "RED", "STALE", "UNKNOWN"]);
const VERIFICATION_STATES = new Set<VerificationState>(["CURRENT", "STALE", "FAILED", "UNKNOWN"]);
const VIOLATION_CODES = new Set<ViolationCode>([
  "QG-001", "QG-002", "QG-003", "QG-004", "QG-005", "QG-006", "QG-007", "QG-008",
  "QG-009", "QG-010", "QG-011", "QG-012", "QG-013", "QG-014", "QG-015", "QG-016",
]);

const CANDIDATE_REQUIRED = [
  "version", "goal", "profile", "initialMode", "ownedPaths", "expectedExistingFiles",
  "allowedNewFiles", "allowedDeletions", "allowedDependencies", "allowedPublicApiChanges",
  "publicApiEvidence", "architectureEvidence", "nonGoals", "requiredChecks", "maxRepairs",
];

const STRING_SCHEMA = { type: "string", minLength: 1, maxLength: 512 } as const;
const STRING_LIST_SCHEMA = {
  type: "array",
  items: STRING_SCHEMA,
  maxItems: 128,
  uniqueItems: true,
} as const;
const CANDIDATE_SCHEMA = {
  type: "object",
  additionalProperties: false,
  required: CANDIDATE_REQUIRED,
  properties: {
    version: { type: "integer", const: 1 },
    goal: STRING_SCHEMA,
    profile: { type: "string", enum: ["inspect", "surgical", "feature", "refactor", "boundary", "visual"] },
    initialMode: { type: "string", enum: ["PLAN", "BUILD", "VERIFY"] },
    ownedPaths: STRING_LIST_SCHEMA,
    expectedExistingFiles: STRING_LIST_SCHEMA,
    allowedNewFiles: STRING_LIST_SCHEMA,
    allowedDeletions: STRING_LIST_SCHEMA,
    allowedDependencies: STRING_LIST_SCHEMA,
    allowedPublicApiChanges: STRING_LIST_SCHEMA,
    publicApiEvidence: STRING_SCHEMA,
    architectureEvidence: STRING_SCHEMA,
    nonGoals: STRING_LIST_SCHEMA,
    requiredChecks: STRING_LIST_SCHEMA,
    maxRepairs: { type: "integer", const: 1 },
  },
} as const;
const CONTRACT_SCHEMA = {
  type: "object",
  additionalProperties: false,
  required: ["action"],
  properties: {
    action: { type: "string", enum: ["propose", "expand", "set_mode", "revoke"] },
    candidate: CANDIDATE_SCHEMA,
    mode: { type: "string", enum: ["PLAN", "BUILD", "VERIFY"] },
  },
} as const;
const STATUS_SCHEMA = {
  type: "object",
  additionalProperties: false,
  required: [],
  properties: {},
} as const;
const CHECK_SCHEMA = {
  type: "object",
  additionalProperties: false,
  required: ["checkId"],
  properties: { checkId: { type: "string", pattern: "^[a-z][a-z0-9._-]{0,63}$" } },
} as const;

type RepairStatus =
  | "eligible"
  | "attempted"
  | "dispatched"
  | "skipped-pending-input"
  | "skipped-busy"
  | "dispatch-failed"
  | "exhausted";

type PendingAdmission = {
  readonly kind: "mutation" | "fabric" | "read" | "check" | "governor" | "other";
  readonly decision?: AdmissionDecision;
};

interface RuntimeState {
  config: GovernorConfig;
  mode: GovernorMode;
  contract?: ConfirmedContract;
  contractRevision: number;
  mutationRevision: number;
  analyzedRevision: number;
  pendingHumanInputs: number;
  humanTurn: number;
  pendingCalls: Map<string, PendingAdmission>;
  completedMutations: Set<string>;
  receipts: Map<string, CheckReceipt>;
  diff?: DiffEvidence;
  bypasses: Set<string>;
  violations: Map<ViolationCode, string>;
  rejectedExpansionTargets: Set<string>;
  vector: QualityVector;
  gate: GateState;
  terminalCandidate: boolean;
  repairStatus: RepairStatus;
  repairAttempted: number;
  verificationOverride?: VerificationState;
  restoredSnapshot: boolean;
  restoredFingerprint?: string;
  restoredCheckedPaths: string[];
  generation: number;
}

interface ContextLike {
  readonly cwd?: string;
  readonly hasUI: boolean;
  readonly ui: {
    confirm(title: string, body: string): Promise<boolean>;
    notify(message: string, level?: "info" | "warning" | "error" | string): void;
    setStatus(key: string, value: string | undefined): void;
    setWidget(key: string, value: string[] | undefined): void;
  };
  readonly sessionManager: {
    getBranch?: () => unknown[];
    getEntries: () => unknown[];
  };
  isProjectTrusted?: () => boolean;
  isIdle(): boolean;
  hasPendingMessages(): boolean;
  getContextUsage?: () => { tokens?: unknown } | undefined;
}

interface InputEventLike {
  readonly source?: unknown;
}

interface BeforeAgentStartLike {
  readonly prompt?: unknown;
}

interface ToolCallLike {
  readonly toolCallId?: unknown;
  readonly toolName?: unknown;
  readonly input?: unknown;
  readonly source?: unknown;
  readonly replayed?: unknown;
}

interface ToolResultLike extends ToolCallLike {
  readonly details?: unknown;
  readonly isError?: unknown;
}

interface ToolExecutionEndLike {
  readonly toolCallId?: unknown;
  readonly isError?: unknown;
}

interface MessageEndLike {
  readonly message?: unknown;
}

interface StatusView {
  readonly version: 1;
  readonly rollout: GovernorConfig["rollout"];
  readonly mode: GovernorMode;
  readonly gate: GateState;
  readonly vector: QualityVector;
  readonly freshness: VerificationState;
  readonly context: { readonly used: number } | "unavailable";
  readonly repair: {
    readonly status: RepairStatus;
    readonly attempted: number;
    readonly maximum: 1;
    readonly code?: "QG-016";
  };
  readonly violations: readonly ViolationCode[];
  readonly disclosure: string;
  readonly nextAction: string;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function exactKeys(value: Record<string, unknown>, allowed: readonly string[]): boolean {
  const accepted = new Set(allowed);
  return Reflect.ownKeys(value).every((key) => typeof key === "string" && accepted.has(key));
}

function safeInteger(value: unknown, minimum = 0): value is number {
  return Number.isSafeInteger(value) && (value as number) >= minimum;
}

function boundedMetadataString(value: unknown, maximum = 128): value is string {
  return typeof value === "string" && value.length > 0 && value.length <= maximum &&
    !value.includes("\0") && /^[A-Za-z0-9._:/-]+$/.test(value);
}

function boundedPath(value: unknown): value is string {
  if (typeof value !== "string" || value.length === 0 || value.length > 1024 || value !== value.trim()) return false;
  if (value.includes("\0") || value.includes("\\") || value.startsWith("/") || /^[A-Za-z]:/.test(value)) return false;
  const path = value.endsWith("/**") ? value.slice(0, -3) : value;
  if (path.length === 0 || path.includes("*") || path.endsWith("/")) return false;
  return !path.split("/").some((segment) => segment.length === 0 || segment === "." || segment === "..");
}

function boundedPathList(value: unknown): string[] | null {
  if (!Array.isArray(value) || value.length > 128) return null;
  const result: string[] = [];
  const seen = new Set<string>();
  for (const item of value) {
    if (!boundedPath(item) || seen.has(item)) return null;
    seen.add(item);
    result.push(item);
  }
  return result;
}

function initialVector(contractRevision = 0, mutationRevision = 0): QualityVector {
  return {
    scope: "UNKNOWN",
    protectedPaths: "PASS",
    newFiles: { count: 0, undeclared: 0 },
    deletedFiles: { count: 0, undeclared: 0 },
    dependencies: "UNKNOWN",
    publicApi: "UNKNOWN",
    architecture: "UNKNOWN",
    verification: "UNKNOWN",
    diff: { files: 0, additions: 0, deletions: 0, outOfScope: [] },
    repair: { attempted: 0, maximum: 1 },
    bypasses: [],
    mode: "PLAN",
    contractRevision,
    mutationRevision,
  };
}

function initialState(config: GovernorConfig): RuntimeState {
  return {
    config,
    mode: "PLAN",
    contractRevision: 0,
    mutationRevision: 0,
    analyzedRevision: 0,
    pendingHumanInputs: 0,
    humanTurn: 0,
    pendingCalls: new Map(),
    completedMutations: new Set(),
    receipts: new Map(),
    bypasses: new Set(),
    violations: new Map(),
    rejectedExpansionTargets: new Set(),
    vector: initialVector(),
    gate: "UNKNOWN",
    terminalCandidate: false,
    repairStatus: "eligible",
    repairAttempted: 0,
    restoredSnapshot: false,
    restoredCheckedPaths: [],
    generation: 0,
  };
}

function verificationFromReceipts(state: RuntimeState): VerificationState {
  if (state.verificationOverride !== undefined) return state.verificationOverride;
  const required = state.contract?.candidate.requiredChecks ?? [];
  if (required.length === 0) return "UNKNOWN";
  const values = required.map((checkId) => state.receipts.get(checkId)?.state ?? "UNKNOWN");
  if (values.includes("FAILED")) return "FAILED";
  if (values.includes("STALE")) return "STALE";
  if (values.every((value) => value === "CURRENT")) return "CURRENT";
  return "UNKNOWN";
}

function evidenceDimension(
  state: RuntimeState,
  evidenceId: string,
  kind: "publicApi" | "architecture",
): QualityVector["publicApi"] | QualityVector["architecture"] {
  if (evidenceId === "not-required") return "NOT_REQUIRED";
  const recipe = declaredRecipe(state, evidenceId);
  if (recipe === null || recipe.dimension !== kind) return "UNKNOWN";
  const receipt = state.receipts.get(evidenceId);
  if (receipt?.state === "CURRENT") return kind === "publicApi" ? "UNCHANGED" : "PASS";
  if (receipt?.state === "FAILED") return kind === "publicApi" ? "CHANGED" : "FAIL";
  return "UNKNOWN";
}

function countUndeclared(paths: readonly string[], allowed: readonly string[]): number {
  const permission = new Set(allowed);
  return paths.filter((path) => !permission.has(path)).length;
}

function rebuildVector(state: RuntimeState): void {
  if (state.restoredSnapshot && state.contract === undefined) {
    state.vector = reduceQualityVector({
      ...state.vector,
      mode: state.mode,
      contractRevision: state.contractRevision,
      mutationRevision: state.mutationRevision,
      repair: { attempted: state.repairAttempted, maximum: 1 },
      verification: state.verificationOverride ?? state.vector.verification,
      bypasses: [...new Set([...state.vector.bypasses, ...state.bypasses])],
    });
    state.gate = selectGate(state.vector);
    return;
  }

  const contract = state.contract?.candidate;
  const diff = state.diff;
  const additions = diff?.additions ?? 0;
  const deletions = diff?.deletions ?? 0;
  const changedPaths = diff?.changedPaths ?? [];
  const newFiles = diff?.newFiles ?? [];
  const deletedFiles = diff?.deletedFiles ?? [];
  const violationCodes = state.violations;
  const scopeFailed = (diff?.outOfScope.length ?? 0) > 0 || violationCodes.has("QG-003") ||
    violationCodes.has("QG-004") || violationCodes.has("QG-010");
  const scopeUnknown = contract === undefined || diff?.state === "UNKNOWN" || violationCodes.has("QG-009");
  const newUndeclared = Math.max(
    contract === undefined ? 0 : countUndeclared(newFiles, contract.allowedNewFiles),
    violationCodes.has("QG-005") ? 1 : 0,
  );
  const deletedUndeclared = Math.max(
    contract === undefined ? 0 : countUndeclared(deletedFiles, contract.allowedDeletions),
    violationCodes.has("QG-006") ? 1 : 0,
  );
  const verification = verificationFromReceipts(state);
  const vector = reduceQualityVector({
    scope: scopeFailed ? "FAIL" : scopeUnknown ? "UNKNOWN" : "PASS",
    protectedPaths: (diff?.protectedPaths.length ?? 0) > 0 || violationCodes.has("QG-008") ? "FAIL" : "PASS",
    newFiles: { count: Math.max(newFiles.length, newUndeclared), undeclared: newUndeclared },
    deletedFiles: { count: Math.max(deletedFiles.length, deletedUndeclared), undeclared: deletedUndeclared },
    dependencies: (diff?.dependencyPaths.length ?? 0) > 0 || violationCodes.has("QG-007")
      ? "CHANGED"
      : contract === undefined || diff?.state === "UNKNOWN" ? "UNKNOWN" : "UNCHANGED",
    publicApi: contract === undefined
      ? "UNKNOWN"
      : evidenceDimension(state, contract.publicApiEvidence, "publicApi") as QualityVector["publicApi"],
    architecture: contract === undefined
      ? "UNKNOWN"
      : evidenceDimension(state, contract.architectureEvidence, "architecture") as QualityVector["architecture"],
    verification,
    diff: {
      files: changedPaths.length,
      additions,
      deletions,
      outOfScope: diff?.outOfScope ?? [],
    },
    repair: { attempted: state.repairAttempted, maximum: 1 },
    bypasses: [...state.bypasses],
    mode: state.mode,
    contractRevision: state.contractRevision,
    mutationRevision: state.mutationRevision,
  });
  state.vector = vector;
  state.gate = selectGate(vector);
}

function statusView(state: RuntimeState, ctx?: ContextLike): StatusView {
  const usage = ctx?.getContextUsage?.();
  const used = usage && safeInteger(usage.tokens) ? usage.tokens : undefined;
  const violations = [...state.violations.keys()].sort();
  const repairCode = state.repairStatus === "eligible" ? {} : { code: "QG-016" as const };
  const nextAction = state.contract === undefined
    ? "Confirm a bounded contract before mutation."
    : state.gate === "GREEN"
      ? "Keep receipts current while completing the confirmed contract."
      : state.mode !== "VERIFY"
        ? "Complete the confirmed work, run declared checks, then enter VERIFY."
        : "Resolve the reported dimensions and rerun declared checks.";
  return {
    version: 1,
    rollout: state.config.rollout,
    mode: state.mode,
    gate: state.gate,
    vector: state.vector,
    freshness: state.vector.verification,
    context: used === undefined ? "unavailable" : { used },
    repair: {
      status: state.repairStatus,
      attempted: state.repairAttempted,
      maximum: 1,
      ...repairCode,
    },
    violations,
    disclosure: "Same-trust mediated control only; this quality governor is not a sandbox.",
    nextAction,
  };
}

function compactStatus(view: StatusView): string {
  const context = view.context === "unavailable" ? "n/a" : String(view.context.used);
  return `QG ${view.rollout} ${view.mode} ${view.gate} freshness=${view.freshness} ` +
    `repair=${view.repair.attempted}/${view.repair.maximum}:${view.repair.status} ` +
    `bypass=${view.vector.bypasses.length} ctx=${context}`;
}

function detailLines(view: StatusView): string[] {
  const vector = view.vector;
  const lines = [
    compactStatus(view),
    `scope=${vector.scope} protected=${vector.protectedPaths} new=${vector.newFiles.count}/${vector.newFiles.undeclared} deleted=${vector.deletedFiles.count}/${vector.deletedFiles.undeclared}`,
    `dependencies=${vector.dependencies} public-api=${vector.publicApi} architecture=${vector.architecture} verification=${vector.verification}`,
    `diff=${vector.diff.files} files +${vector.diff.additions}/-${vector.diff.deletions} revisions=${vector.contractRevision}/${vector.mutationRevision}`,
    `violations=${view.violations.length === 0 ? "none" : view.violations.join(",")} bypasses=${vector.bypasses.length}`,
  ];
  if (vector.diff.outOfScope.length > 0) lines.push(`out-of-scope=${vector.diff.outOfScope.join(",")}`);
  if (vector.bypasses.length > 0) lines.push(`bypass-refs=${vector.bypasses.join(",")}`);
  lines.push(view.disclosure);
  return lines;
}

function renderStatus(state: RuntimeState, ctx: ContextLike): StatusView {
  const view = statusView(state, ctx);
  ctx.ui.setStatus(STATUS_KEY, compactStatus(view));
  ctx.ui.setWidget(WIDGET_KEY, detailLines(view));
  return view;
}

function latestReceiptIdentity(state: RuntimeState): {
  readonly fingerprint?: string;
  readonly checkedPaths: readonly string[];
} {
  const current = [...state.receipts.values()]
    .filter((receipt) => receipt.state === "CURRENT")
    .sort((left, right) => left.recipeId.localeCompare(right.recipeId));
  const receipt = current[0];
  if (receipt === undefined) {
    return { fingerprint: state.restoredFingerprint, checkedPaths: state.restoredCheckedPaths };
  }
  const oneIdentity = current.every((candidate) =>
    candidate.fingerprint === receipt.fingerprint &&
    candidate.checkedPaths.length === receipt.checkedPaths.length &&
    candidate.checkedPaths.every((path, index) => path === receipt.checkedPaths[index])
  );
  return oneIdentity
    ? { fingerprint: receipt.fingerprint, checkedPaths: receipt.checkedPaths }
    : { checkedPaths: [] };
}

function persistedMetadata(state: RuntimeState): Record<string, unknown> {
  const identity = latestReceiptIdentity(state);
  return {
    version: 1,
    mode: state.mode,
    gate: state.gate,
    vector: state.vector,
    contractRevision: state.contractRevision,
    mutationRevision: state.mutationRevision,
    analyzedRevision: state.analyzedRevision,
    verification: state.vector.verification,
    ...(identity.fingerprint === undefined ? {} : { fingerprint: identity.fingerprint }),
    checkedPaths: [...identity.checkedPaths],
    recipeIds: [...state.receipts.keys()].sort(),
    bypasses: [...state.bypasses].sort(),
    violations: [...state.violations.keys()].sort(),
    repairStatus: state.repairStatus,
    repairAttempted: state.repairAttempted,
    humanTurn: state.humanTurn,
  };
}

function safeVector(value: unknown): QualityVector | null {
  if (!isRecord(value) || !exactKeys(value, [
    "scope", "protectedPaths", "newFiles", "deletedFiles", "dependencies", "publicApi",
    "architecture", "verification", "diff", "repair", "bypasses", "mode", "contractRevision",
    "mutationRevision",
  ])) return null;
  if (!["PASS", "FAIL", "UNKNOWN"].includes(String(value.scope))) return null;
  if (!["PASS", "FAIL"].includes(String(value.protectedPaths))) return null;
  if (!["UNCHANGED", "CHANGED", "UNKNOWN"].includes(String(value.dependencies))) return null;
  if (!["UNCHANGED", "CHANGED", "NOT_REQUIRED", "UNKNOWN"].includes(String(value.publicApi))) return null;
  if (!["PASS", "FAIL", "NOT_REQUIRED", "UNKNOWN"].includes(String(value.architecture))) return null;
  if (!VERIFICATION_STATES.has(value.verification as VerificationState) || !MODES.has(value.mode as GovernorMode)) return null;
  if (!isRecord(value.newFiles) || !isRecord(value.deletedFiles) || !isRecord(value.diff) || !isRecord(value.repair)) return null;
  if (!exactKeys(value.newFiles, ["count", "undeclared"]) || !exactKeys(value.deletedFiles, ["count", "undeclared"])) return null;
  if (!exactKeys(value.diff, ["files", "additions", "deletions", "outOfScope"]) || !exactKeys(value.repair, ["attempted", "maximum"])) return null;
  const numbers = [
    value.newFiles.count, value.newFiles.undeclared, value.deletedFiles.count, value.deletedFiles.undeclared,
    value.diff.files, value.diff.additions, value.diff.deletions, value.repair.attempted,
    value.contractRevision, value.mutationRevision,
  ];
  if (numbers.some((number) => !safeInteger(number)) || value.repair.maximum !== 1) return null;
  const outOfScope = boundedPathList(value.diff.outOfScope);
  if (outOfScope === null || !Array.isArray(value.bypasses) || value.bypasses.length > 128) return null;
  const bypasses: string[] = [];
  for (const bypass of value.bypasses) {
    if (!boundedMetadataString(bypass)) return null;
    bypasses.push(bypass);
  }
  return reduceQualityVector({
    scope: value.scope as QualityVector["scope"],
    protectedPaths: value.protectedPaths as QualityVector["protectedPaths"],
    newFiles: { count: value.newFiles.count as number, undeclared: value.newFiles.undeclared as number },
    deletedFiles: { count: value.deletedFiles.count as number, undeclared: value.deletedFiles.undeclared as number },
    dependencies: value.dependencies as QualityVector["dependencies"],
    publicApi: value.publicApi as QualityVector["publicApi"],
    architecture: value.architecture as QualityVector["architecture"],
    verification: value.verification as VerificationState,
    diff: {
      files: value.diff.files as number,
      additions: value.diff.additions as number,
      deletions: value.diff.deletions as number,
      outOfScope,
    },
    repair: { attempted: value.repair.attempted as number, maximum: 1 },
    bypasses,
    mode: value.mode as GovernorMode,
    contractRevision: value.contractRevision as number,
    mutationRevision: value.mutationRevision as number,
  });
}

const METADATA_KEYS = [
  "version", "mode", "gate", "vector", "contractRevision", "mutationRevision", "analyzedRevision",
  "verification", "fingerprint", "checkedPaths", "recipeIds", "bypasses", "violations",
  "repairStatus", "repairAttempted", "humanTurn",
] as const;

function restoreMetadata(state: RuntimeState, input: unknown): boolean {
  if (!isRecord(input) || !exactKeys(input, METADATA_KEYS) || input.version !== 1) return false;
  if (input.mode !== undefined && !MODES.has(input.mode as GovernorMode)) return false;
  if (input.gate !== undefined && !GATES.has(input.gate as GateState)) return false;
  for (const key of ["contractRevision", "mutationRevision", "analyzedRevision", "repairAttempted", "humanTurn"] as const) {
    if (input[key] !== undefined && !safeInteger(input[key])) return false;
  }
  if (input.verification !== undefined && !VERIFICATION_STATES.has(input.verification as VerificationState)) return false;
  if (input.fingerprint !== undefined && (typeof input.fingerprint !== "string" || !/^[0-9a-f]{64}$/.test(input.fingerprint))) return false;
  const checkedPaths = input.checkedPaths === undefined ? [] : boundedPathList(input.checkedPaths);
  if (checkedPaths === null) return false;
  for (const key of ["recipeIds", "bypasses"] as const) {
    const values = input[key];
    if (values !== undefined && (
      !Array.isArray(values) || values.length > 128 || new Set(values).size !== values.length ||
      values.some((item) => !boundedMetadataString(item))
    )) return false;
  }
  if (input.violations !== undefined && (
    !Array.isArray(input.violations) || input.violations.length > 16 ||
    input.violations.some((item) => !VIOLATION_CODES.has(item as ViolationCode))
  )) return false;
  const repairStatuses: readonly RepairStatus[] = [
    "eligible", "attempted", "dispatched", "skipped-pending-input", "skipped-busy", "dispatch-failed", "exhausted",
  ];
  if (input.repairStatus !== undefined && !repairStatuses.includes(input.repairStatus as RepairStatus)) return false;
  const restoredVector = input.vector === undefined ? null : safeVector(input.vector);
  if (input.vector !== undefined && restoredVector === null) return false;
  const restoredMode = input.mode as GovernorMode ?? state.mode;
  const contractRevision = input.contractRevision as number ?? state.contractRevision;
  const mutationRevision = input.mutationRevision as number ?? state.mutationRevision;
  const vector = restoredVector ?? initialVector(contractRevision, mutationRevision);
  const derivedGate = selectGate(vector);
  const repairAttempted = input.repairAttempted as number ?? state.repairAttempted;
  const restoredBypasses = Array.isArray(input.bypasses) ? [...input.bypasses] as string[] : [];
  const vectorBypasses = [...vector.bypasses].sort();
  restoredBypasses.sort();
  if (
    (restoredVector !== null && (
      vector.mode !== restoredMode || vector.contractRevision !== contractRevision ||
      vector.mutationRevision !== mutationRevision || vector.repair.attempted !== repairAttempted ||
      (input.verification !== undefined && vector.verification !== input.verification) ||
      vectorBypasses.length !== restoredBypasses.length ||
      vectorBypasses.some((bypass, index) => bypass !== restoredBypasses[index])
    )) ||
    (input.gate !== undefined && input.gate !== derivedGate) ||
    (derivedGate === "GREEN" && (input.fingerprint === undefined || checkedPaths.length === 0))
  ) return false;

  state.mode = restoredMode;
  state.contractRevision = contractRevision;
  state.mutationRevision = mutationRevision;
  state.analyzedRevision = input.analyzedRevision as number ?? state.analyzedRevision;
  state.repairAttempted = repairAttempted;
  state.humanTurn = input.humanTurn as number ?? state.humanTurn;
  state.repairStatus = input.repairStatus as RepairStatus ?? state.repairStatus;
  state.restoredFingerprint = input.fingerprint as string | undefined;
  state.restoredCheckedPaths = checkedPaths;
  if (Array.isArray(input.bypasses)) {
    for (const bypass of input.bypasses) state.bypasses.add(bypass as string);
  }
  if (Array.isArray(input.violations)) {
    for (const code of input.violations) state.violations.set(code as ViolationCode, "restored metadata finding");
  }
  const restorationSafeVector = vector.verification === "CURRENT"
    ? reduceQualityVector({ ...vector, verification: "UNKNOWN" })
    : vector;
  state.vector = restorationSafeVector;
  state.gate = restorationSafeVector === vector ? derivedGate : selectGate(restorationSafeVector);
  state.restoredSnapshot = true;
  return true;
}

function activeEntries(ctx: ContextLike): unknown[] {
  const branch = ctx.sessionManager.getBranch?.();
  return Array.isArray(branch) ? branch : ctx.sessionManager.getEntries();
}

function restoreLatest(state: RuntimeState, ctx: ContextLike): void {
  const entries = activeEntries(ctx);
  for (let index = entries.length - 1; index >= 0; index--) {
    const entry = entries[index];
    if (!isRecord(entry) || entry.type !== "custom" || entry.customType !== ENTRY_TYPE) continue;
    if (restoreMetadata(state, entry.data)) return;
  }
}

function toolResult(text: string, details: Record<string, unknown>): Record<string, unknown> {
  return { content: [{ type: "text", text }], details };
}

function proposalBody(candidate: ContractCandidate, current?: ConfirmedContract): string {
  const previousNew = new Set(current?.candidate.allowedNewFiles ?? []);
  const addedNew = candidate.allowedNewFiles.filter((path) => !previousNew.has(path));
  const previous = current === undefined ? [] : [
    `Previous owned: ${current.candidate.ownedPaths.join(", ") || "none"}`,
    `Previous new/deletions: ${current.candidate.allowedNewFiles.join(", ") || "none"} / ${current.candidate.allowedDeletions.join(", ") || "none"}`,
    `Previous checks: ${current.candidate.requiredChecks.join(", ")}`,
  ];
  return [
    current === undefined ? "Confirm quality contract" : `Confirm quality contract expansion from revision ${current.revision}`,
    ...previous,
    `Goal: ${candidate.goal}`,
    `Profile/mode: ${candidate.profile}/${candidate.initialMode}`,
    `Owned: ${candidate.ownedPaths.join(", ") || "none"}`,
    `Expected existing: ${candidate.expectedExistingFiles.join(", ") || "none"}`,
    `Allowed new: ${candidate.allowedNewFiles.join(", ") || "none"}`,
    `Added new: ${addedNew.join(", ") || "none"}`,
    `Allowed deletions: ${candidate.allowedDeletions.join(", ") || "none"}`,
    `Dependency permissions: ${candidate.allowedDependencies.join(", ") || "none"}`,
    `Public API permissions/evidence: ${candidate.allowedPublicApiChanges.join(", ") || "none"} / ${candidate.publicApiEvidence}`,
    `Architecture evidence: ${candidate.architectureEvidence}`,
    `Required checks: ${candidate.requiredChecks.join(", ")}`,
    `Non-goals: ${candidate.nonGoals.join(", ") || "none"}`,
    `Automatic repairs: ${candidate.maxRepairs}`,
    "Same-trust disclosure: mediated Pi/Fabric control only; this is not a sandbox.",
  ].join("\n");
}

function confirmationFailure(state: RuntimeState, reason: string): Record<string, unknown> {
  state.violations.set("QG-002", reason);
  return toolResult(`QG-002 ${reason}`, { ok: false, code: "QG-002", gate: state.gate });
}

function invalidateReceipts(state: RuntimeState, staleWhenCurrent = true): void {
  const hadCurrent = state.restoredFingerprint !== undefined ||
    [...state.receipts.values()].some((receipt) => receipt.state === "CURRENT");
  state.receipts.clear();
  state.restoredFingerprint = undefined;
  state.restoredCheckedPaths = [];
  state.verificationOverride = staleWhenCurrent && hadCurrent ? "STALE" : undefined;
  state.restoredSnapshot = false;
}

function boundedCompletedSet(state: RuntimeState): void {
  if (state.completedMutations.size <= 4096) return;
  const excess = state.completedMutations.size - 4096;
  let removed = 0;
  for (const id of state.completedMutations) {
    state.completedMutations.delete(id);
    removed++;
    if (removed >= excess) break;
  }
}

function recordDecision(state: RuntimeState, decision: AdmissionDecision): void {
  if (decision.code !== undefined) state.violations.set(decision.code, decision.reason.slice(0, 256));
  if (decision.code === "QG-011") state.verificationOverride = "UNKNOWN";
  if (decision.code === "QG-012" || decision.code === "QG-013") state.verificationOverride = "STALE";
  rebuildVector(state);
}

function reconcileTools(pi: ExtensionAPI, state: RuntimeState): void {
  if (state.config.rollout === "observe") return;
  const inventory = new Set(
    pi.getAllTools()
      .map((tool) => isRecord(tool) && typeof tool.name === "string" ? tool.name : undefined)
      .filter((name): name is string => name !== undefined),
  );
  const configured = state.config.tools[state.mode];
  const names = configured
    .filter((name) => name !== "bash" && inventory.has(name))
    .filter((name, index, values) => values.indexOf(name) === index)
    .sort();
  pi.setActiveTools(names);
}

async function canonicalMutation(
  root: string,
  toolName: string,
  input: Record<string, unknown>,
): Promise<{
  readonly target?: string;
  readonly targetExists?: boolean;
  readonly pathVerified: boolean;
  readonly contentLength?: number;
}> {
  const rawTarget = input.path;
  if (typeof rawTarget !== "string") return { pathVerified: false };
  const contentLength = typeof input.content === "string" ? Buffer.byteLength(input.content, "utf8") : undefined;
  if (toolName === "edit") {
    const existing = await canonicalizeTarget(root, rawTarget, true);
    return existing.ok
      ? { target: existing.relativeTarget, targetExists: true, pathVerified: true }
      : { target: rawTarget, pathVerified: false };
  }
  const existing = await canonicalizeTarget(root, rawTarget, true);
  if (existing.ok) {
    return {
      target: existing.relativeTarget,
      targetExists: true,
      pathVerified: true,
      ...(contentLength === undefined ? {} : { contentLength }),
    };
  }
  const created = await canonicalizeTarget(root, rawTarget, false);
  if (created.ok) {
    return {
      target: created.relativeTarget,
      targetExists: false,
      pathVerified: true,
      ...(contentLength === undefined ? {} : { contentLength }),
    };
  }
  return {
    target: rawTarget,
    pathVerified: false,
    ...(contentLength === undefined ? {} : { contentLength }),
  };
}

function normalizedToolName(name: string): string {
  if (name.startsWith("pi.")) return name.slice(3);
  if (name.startsWith("extensions.")) return name.slice("extensions.".length);
  return name;
}

function pendingResponse(pending: PendingAdmission): { block: true; reason: string } | undefined {
  if (pending.decision?.admitted === false) {
    return { block: true, reason: `${pending.decision.code ?? "QG-010"} ${pending.decision.reason}` };
  }
  return undefined;
}

interface FabricOperation {
  readonly ref: string;
  readonly outcome: "succeeded" | "failed" | "aborted" | "timed_out";
}

function strictFabricOperations(details: unknown): FabricOperation[] | null {
  if (!isRecord(details) || !exactKeys(details, ["success", "trace"]) || typeof details.success !== "boolean") return null;
  const trace = details.trace;
  if (!isRecord(trace) || !exactKeys(trace, ["kind", "version", "outcome", "phases", "operations", "counts", "error"])) return null;
  if (trace.kind !== "pi-fabric.execution" || trace.version !== 1 ||
    !["succeeded", "failed", "aborted", "timed_out"].includes(String(trace.outcome))) return null;
  if (details.success !== (trace.outcome === "succeeded")) return null;
  if (!Array.isArray(trace.phases) || trace.phases.length > 256 ||
    trace.phases.some((phase) => !boundedMetadataString(phase))) return null;
  if (!isRecord(trace.counts) || !exactKeys(trace.counts, [
    "droppedValues", "truncatedValues", "redactedValues", "droppedOperations",
  ])) return null;
  for (const key of ["droppedValues", "truncatedValues", "redactedValues", "droppedOperations"] as const) {
    if (!safeInteger(trace.counts[key])) return null;
  }
  if (trace.error !== undefined && !boundedMetadataString(trace.error, 256)) return null;
  if (!Array.isArray(trace.operations) || trace.operations.length > 4096) return null;
  const operations: FabricOperation[] = [];
  let previousSequence = 0;
  for (const operation of trace.operations) {
    if (!isRecord(operation) || !exactKeys(operation, [
      "type", "sequence", "ref", "provider", "action", "args", "outcome", "failureStage", "error", "result",
    ])) return null;
    if (operation.type !== "call" || !safeInteger(operation.sequence, 1) || operation.sequence <= previousSequence) return null;
    if (!boundedMetadataString(operation.ref, 256) || !isRecord(operation.args)) return null;
    if (!["succeeded", "failed", "aborted", "timed_out"].includes(String(operation.outcome))) return null;
    if (operation.provider !== undefined && !boundedMetadataString(operation.provider)) return null;
    if (operation.action !== undefined && !boundedMetadataString(operation.action)) return null;
    if (operation.failureStage !== undefined && !["resolve", "prepare", "validate", "approve", "invoke", "guard"].includes(String(operation.failureStage))) return null;
    if (operation.error !== undefined && !boundedMetadataString(operation.error, 256)) return null;
    previousSequence = operation.sequence;
    operations.push({ ref: operation.ref, outcome: operation.outcome as FabricOperation["outcome"] });
  }
  if ((trace.counts.droppedOperations as number) > 0) return null;
  return operations;
}

function mediatedFabricRef(ref: string): boolean {
  if (["pi.read", "pi.grep", "pi.find", "pi.ls", "pi.edit", "pi.write"].includes(ref)) return true;
  if (["extensions.quality_contract", "extensions.quality_status", "extensions.quality_check"].includes(ref)) return true;
  return ref.startsWith("fabric.discovery.") || ref.startsWith("fabric.workflow.");
}

function inspectFabricResult(state: RuntimeState, details: unknown): void {
  const operations = strictFabricOperations(details);
  if (operations === null) {
    state.bypasses.add("QG-014:malformed-fabric-trace");
    state.violations.set("QG-014", "Fabric trace was absent, malformed, unknown, or incomplete");
    rebuildVector(state);
    return;
  }
  for (const operation of operations) {
    if (operation.outcome !== "succeeded" || mediatedFabricRef(operation.ref)) continue;
    state.bypasses.add(`QG-014:${operation.ref}`.slice(0, 128));
    state.violations.set("QG-014", "agent, provider, extension, process, or external effect bypassed mediated proof");
  }
  rebuildVector(state);
}

function declaredRecipe(state: RuntimeState, checkId: string): CheckRecipe | null {
  const resolved = resolveCheckRecipe(state.config.recipes, checkId);
  return resolved.ok ? resolved.value : null;
}

function receiptSummary(receipt: CheckReceipt): Record<string, unknown> {
  return {
    state: receipt.state,
    ...(receipt.code === undefined ? {} : { code: receipt.code }),
    recipeId: receipt.recipeId,
    contractRevision: receipt.contractRevision,
    mutationRevision: receipt.mutationRevision,
    outputRef: receipt.outputDigest === undefined ? "unavailable" : `qg:${receipt.outputDigest.slice(0, 24)}`,
  };
}

function terminalTextMessage(message: unknown): { readonly message: Record<string, unknown>; readonly content: unknown[] } | null {
  if (!isRecord(message) || message.role !== "assistant" || !Array.isArray(message.content)) return null;
  let hasText = false;
  for (const block of message.content) {
    if (!isRecord(block)) return null;
    if (block.type === "toolCall") return null;
    if (block.type === "text") {
      if (typeof block.text !== "string") return null;
      hasText ||= block.text.trim().length > 0;
    }
  }
  return hasText ? { message, content: message.content } : null;
}

function safeContextRoot(ctx: ContextLike): string {
  return typeof ctx.cwd === "string" && ctx.cwd.length > 0 ? ctx.cwd : process.cwd();
}

export default async function qualityGovernor(pi: ExtensionAPI): Promise<void> {
  let state = initialState(await loadGovernorConfig(process.cwd(), false));

  const appendState = (): void => {
    pi.appendEntry(ENTRY_TYPE, persistedMetadata(state));
  };

  const refreshDiff = async (ctx: ContextLike, force = false): Promise<void> => {
    const contract = state.contract;
    if (contract === undefined || (!force && state.mutationRevision <= state.analyzedRevision)) return;
    const contractRevision = state.contractRevision;
    const mutationRevision = state.mutationRevision;
    const generation = state.generation;
    const evidence = await collectDiffEvidence(safeContextRoot(ctx), {
      ownedPaths: contract.candidate.ownedPaths,
      protectedPaths: state.config.protectedPaths,
      dependencyPaths: state.config.dependencyPaths,
      limits: state.config.limits,
    });
    if (
      state.contract !== contract || state.contractRevision !== contractRevision ||
      state.mutationRevision !== mutationRevision || state.generation !== generation
    ) return;
    state.diff = evidence;
    state.analyzedRevision = mutationRevision;
    rebuildVector(state);
  };

  const revalidateGate = async (ctx: ContextLike): Promise<void> => {
    if (state.restoredFingerprint !== undefined && state.restoredCheckedPaths.length > 0) {
      const expected = state.restoredFingerprint;
      const paths = [...state.restoredCheckedPaths];
      const generation = state.generation;
      const fingerprint = await fingerprintRepository(safeContextRoot(ctx), paths);
      if (state.generation === generation && state.restoredFingerprint === expected) {
        const freshness: VerificationState = !fingerprint.complete
          ? "UNKNOWN"
          : fingerprint.digest === expected ? "UNKNOWN" : "STALE";
        state.vector = reduceQualityVector({ ...state.vector, verification: freshness });
        state.gate = selectGate(state.vector);
      }
    }

    const currentReceipts = [...state.receipts.entries()]
      .filter(([, receipt]) => receipt.state === "CURRENT");
    for (const [checkId, receipt] of currentReceipts) {
      const recipe = declaredRecipe(state, checkId);
      if (recipe === null) continue;
      const paths = [...receipt.checkedPaths];
      const contractRevision = state.contractRevision;
      const mutationRevision = state.mutationRevision;
      const generation = state.generation;
      const fingerprint = await fingerprintRepository(safeContextRoot(ctx), paths, {
        configDigest: state.config.configDigest,
        limits: state.config.limits,
      });
      if (
        state.generation !== generation || state.contractRevision !== contractRevision ||
        state.mutationRevision !== mutationRevision || state.receipts.get(checkId) !== receipt
      ) continue;
      if (!fingerprint.complete) {
        state.receipts.set(checkId, { ...receipt, state: "UNKNOWN", code: "QG-011", reason: "gate-time fingerprint is unavailable" });
        continue;
      }
      state.receipts.set(checkId, validateReceiptFreshness(receipt, {
        contractRevision,
        mutationRevision,
        fingerprint: fingerprint.digest,
        checkedPaths: paths,
        recipeId: recipe.id,
        recipeVersion: recipe.version,
        recipeDigest: recipe.recipeDigest,
        configDigest: state.config.configDigest,
      }));
    }
    rebuildVector(state);
  };

  const staleConfirmation = (ctx: ContextLike): Record<string, unknown> => {
    const reason = "confirmation completed against an obsolete contract revision";
    state.violations.set("QG-013", reason);
    rebuildVector(state);
    appendState();
    renderStatus(state, ctx);
    return toolResult(`QG-013 ${reason}`, {
      ok: false,
      code: "QG-013",
      state: "STALE",
      contractRevision: state.contractRevision,
      mode: state.mode,
      gate: state.gate,
    });
  };

  const contractAction = async (params: Record<string, unknown>, ctx: ContextLike): Promise<Record<string, unknown>> => {
    const action = params.action;
    if (action === "propose") {
      const current = state.contract;
      if (current !== undefined) {
        state.violations.set("QG-015", "an active contract must be expanded, mode-changed, or revoked");
        return toolResult("QG-015 an active contract already exists", { ok: false, code: "QG-015" });
      }
      const parsed = parseContractCandidate(params.candidate);
      if (!parsed.ok) {
        state.violations.set(parsed.code, parsed.reason);
        rebuildVector(state);
        return toolResult(`${parsed.code} ${parsed.reason}`, { ok: false, code: parsed.code });
      }
      if (!ctx.hasUI) return confirmationFailure(state, "HEADLESS_CONFIRMATION_REQUIRED");
      const generation = state.generation;
      const contractRevision = state.contractRevision;
      const confirmed = await ctx.ui.confirm("Confirm quality contract", proposalBody(parsed.value));
      if (
        state.generation !== generation || state.contractRevision !== contractRevision ||
        state.contract !== current
      ) return staleConfirmation(ctx);
      const activated = confirmContract(parsed.value, confirmed, contractRevision);
      if (!activated.ok) return confirmationFailure(state, activated.reason);
      state.contract = activated.value;
      state.contractRevision = activated.value.revision;
      state.mode = activated.value.candidate.initialMode;
      state.violations.clear();
      state.rejectedExpansionTargets.clear();
      state.generation++;
      invalidateReceipts(state, false);
      rebuildVector(state);
      reconcileTools(pi, state);
      appendState();
      renderStatus(state, ctx);
      return toolResult(`Confirmed quality contract revision ${state.contractRevision}`, {
        ok: true, contractRevision: state.contractRevision, mode: state.mode, gate: state.gate,
      });
    }

    if (action === "expand") {
      const current = state.contract;
      if (current === undefined) {
        state.violations.set("QG-001", "no confirmed contract can be expanded");
        rebuildVector(state);
        return toolResult("QG-001 no confirmed contract", { ok: false, code: "QG-001" });
      }
      const parsed = parseContractCandidate(params.candidate);
      if (!parsed.ok) {
        state.violations.set(parsed.code, parsed.reason);
        rebuildVector(state);
        return toolResult(`${parsed.code} ${parsed.reason}`, { ok: false, code: parsed.code });
      }
      const newlyRequested = parsed.value.allowedNewFiles.filter(
        (path) => !current.candidate.allowedNewFiles.includes(path),
      );
      if (!ctx.hasUI) {
        for (const path of newlyRequested) state.rejectedExpansionTargets.add(path);
        return confirmationFailure(state, "HEADLESS_CONFIRMATION_REQUIRED");
      }
      const generation = state.generation;
      const contractRevision = state.contractRevision;
      const confirmed = await ctx.ui.confirm("Confirm quality contract expansion", proposalBody(parsed.value, current));
      if (
        state.generation !== generation || state.contractRevision !== contractRevision ||
        state.contract !== current
      ) return staleConfirmation(ctx);
      if (!confirmed) {
        for (const path of newlyRequested) state.rejectedExpansionTargets.add(path);
        return confirmationFailure(state, "contract expansion declined");
      }
      const revised = reviseContract(current, parsed.value, true);
      if (!revised.ok) {
        state.violations.set(revised.code, revised.reason);
        rebuildVector(state);
        return toolResult(`${revised.code} ${revised.reason}`, { ok: false, code: revised.code });
      }
      state.contract = revised.value;
      state.contractRevision = revised.value.revision;
      for (const code of ["QG-002", "QG-004", "QG-005", "QG-006", "QG-007"] as const) {
        state.violations.delete(code);
      }
      state.rejectedExpansionTargets.clear();
      state.generation++;
      invalidateReceipts(state);
      rebuildVector(state);
      reconcileTools(pi, state);
      appendState();
      renderStatus(state, ctx);
      return toolResult(`Confirmed quality contract revision ${state.contractRevision}`, {
        ok: true, contractRevision: state.contractRevision, mode: state.mode, gate: state.gate,
      });
    }

    if (action === "set_mode") {
      if (state.contract === undefined) {
        state.violations.set("QG-001", "mode changes require a confirmed contract");
        rebuildVector(state);
        return toolResult("QG-001 no confirmed contract", { ok: false, code: "QG-001" });
      }
      if (!MODES.has(params.mode as GovernorMode)) {
        state.violations.set("QG-015", "mode is invalid");
        rebuildVector(state);
        return toolResult("QG-015 invalid mode", { ok: false, code: "QG-015" });
      }
      state.mode = params.mode as GovernorMode;
      state.violations.delete("QG-003");
      state.generation++;
      rebuildVector(state);
      reconcileTools(pi, state);
      appendState();
      renderStatus(state, ctx);
      return toolResult(`Quality mode set to ${state.mode}; scope is unchanged`, {
        ok: true, mode: state.mode, contractRevision: state.contractRevision, gate: state.gate,
      });
    }

    if (action === "revoke") {
      if (state.contract !== undefined) state.contractRevision = revokeContract(state.contract).revision;
      else state.contractRevision = Math.max(1, state.contractRevision + 1);
      state.contract = undefined;
      state.mode = "PLAN";
      state.generation++;
      invalidateReceipts(state, false);
      state.diff = undefined;
      state.violations.clear();
      state.rejectedExpansionTargets.clear();
      state.gate = "UNKNOWN";
      state.vector = initialVector(state.contractRevision, state.mutationRevision);
      reconcileTools(pi, state);
      appendState();
      renderStatus(state, ctx);
      return toolResult("Quality contract revoked; mutation authority removed and gate UNKNOWN", {
        ok: true, revoked: true, contractRevision: state.contractRevision, gate: state.gate,
      });
    }

    state.violations.set("QG-015", "contract action is invalid");
    rebuildVector(state);
    return toolResult("QG-015 invalid contract action", { ok: false, code: "QG-015" });
  };

  const executeCheck = async (
    checkId: unknown,
    signal: AbortSignal | undefined,
    ctx: ContextLike,
  ): Promise<Record<string, unknown>> => {
    if (typeof checkId !== "string") {
      state.verificationOverride = "UNKNOWN";
      state.violations.set("QG-011", "check ID is invalid");
      rebuildVector(state);
      return toolResult("QG-011 invalid check ID", { ok: false, code: "QG-011" });
    }
    const recipeResult = resolveCheckRecipe(state.config.recipes, checkId);
    if (!recipeResult.ok) {
      state.verificationOverride = "UNKNOWN";
      state.violations.set(recipeResult.code, recipeResult.reason);
      rebuildVector(state);
      return toolResult(`${recipeResult.code} ${recipeResult.reason}`, { ok: false, code: recipeResult.code });
    }
    const decision = decideAdmission({
      contract: state.contract,
      mode: state.mode,
      rollout: state.config.rollout,
      effect: "check",
      toolName: "quality_check",
      toolCallId: `quality-check:${checkId}`,
      identity: { kind: "direct", source: "quality-governor", toolName: "quality_check" },
      repositoryRoot: safeContextRoot(ctx),
      checkId,
    });
    recordDecision(state, decision);
    if (!decision.admitted) {
      return toolResult(`${decision.code ?? "QG-011"} ${decision.reason}`, {
        ok: false, code: decision.code ?? "QG-011",
      });
    }
    const recipe = recipeResult.value;
    const checkedPaths = [...(recipe.checkedPaths ?? [])];
    const contractRevision = state.contractRevision;
    const mutationRevision = state.mutationRevision;
    const generation = state.generation;
    const fingerprint = await fingerprintRepository(safeContextRoot(ctx), checkedPaths, {
      configDigest: state.config.configDigest,
      limits: state.config.limits,
    });
    if (!fingerprint.complete) {
      state.verificationOverride = "UNKNOWN";
      state.violations.set("QG-011", "pre-check repository fingerprint is unavailable");
      rebuildVector(state);
      renderStatus(state, ctx);
      return toolResult("QG-011 check unavailable because repository fingerprint is incomplete", {
        ok: false, code: "QG-011", state: "UNKNOWN",
      });
    }
    const candidatePaths = state.contract === undefined
      ? []
      : [
          ...state.contract.candidate.ownedPaths,
          ...state.contract.candidate.expectedExistingFiles,
          ...state.contract.candidate.allowedNewFiles,
          ...state.contract.candidate.allowedDeletions,
        ];
    const VOLATILE_HOST_RUNTIME_RULES = new Set([".pi/fabric/**", ".pi/state/**", ".pi/state.md", ".pi/prewalk.json"]);
    const broadPaths = [...new Set([
      ...checkedPaths,
      ...candidatePaths,
      ...state.config.protectedPaths.filter((rule) => !VOLATILE_HOST_RUNTIME_RULES.has(rule)),
      ...state.config.dependencyPaths,
    ])].sort();
    const broadSnapshot = () => fingerprintRepository(safeContextRoot(ctx), broadPaths, {
      configDigest: state.config.configDigest,
      limits: state.config.limits,
    });
    const receipt = await runCheckRecipe(recipe, {
      contractRevision,
      mutationRevision,
      checkedPaths,
      fingerprint: fingerprint.digest,
      repositoryRoot: safeContextRoot(ctx),
      configDigest: state.config.configDigest,
      broadSnapshot,
      ...(signal === undefined ? {} : { signal }),
    });
    if (
      state.contractRevision !== contractRevision || state.mutationRevision !== mutationRevision ||
      state.generation !== generation
    ) {
      state.verificationOverride = "STALE";
      state.violations.set("QG-013", "check completed against an obsolete revision");
      rebuildVector(state);
      appendState();
      renderStatus(state, ctx);
      return toolResult("QG-013 check completed against an obsolete revision", {
        ok: false, code: "QG-013", state: "STALE",
      });
    }
    state.receipts.set(checkId, receipt);
    state.verificationOverride = undefined;
    for (const code of ["QG-011", "QG-012", "QG-013"] as const) state.violations.delete(code);
    for (const current of state.receipts.values()) {
      if (current.code !== undefined) state.violations.set(current.code, current.reason ?? "check finding");
    }
    state.restoredSnapshot = false;
    rebuildVector(state);
    appendState();
    renderStatus(state, ctx);
    return toolResult(`Quality check ${checkId}: ${receipt.state}`, receiptSummary(receipt));
  };

  pi.registerTool({
    name: "quality_contract",
    label: "Quality Contract",
    description: "Propose, expand, mode-change, or revoke a bounded quality contract. Confirmation is interactive and same-trust, not a sandbox.",
    parameters: CONTRACT_SCHEMA,
    async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
      return contractAction(isRecord(params) ? params : {}, ctx as ContextLike);
    },
  });

  pi.registerTool({
    name: "quality_status",
    label: "Quality Status",
    description: "Return compact non-scalar quality dimensions, freshness, gate, bypass, and repair metadata.",
    parameters: STATUS_SCHEMA,
    async execute(_toolCallId, _params, _signal, _onUpdate, ctx) {
      const context = ctx as ContextLike;
      await refreshDiff(context, true);
      await revalidateGate(context);
      const view = renderStatus(state, context);
      return toolResult(compactStatus(view), { ...view });
    },
  });

  pi.registerTool({
    name: "quality_check",
    label: "Quality Check",
    description: "Run one declared trusted check recipe by ID; arbitrary commands and arguments are unavailable.",
    parameters: CHECK_SCHEMA,
    async execute(_toolCallId, params, signal, _onUpdate, ctx) {
      const checkId = isRecord(params) ? params.checkId : undefined;
      return executeCheck(checkId, signal, ctx as ContextLike);
    },
  });

  pi.registerCommand("quality", {
    description: "Show quality-governor detail, or reduce authority with /quality revoke",
    handler: async (args, rawContext) => {
      const ctx = rawContext as ContextLike;
      if (args.trim() === "revoke") {
        await contractAction({ action: "revoke" }, ctx);
        ctx.ui.notify("Quality contract revoked; mutation authority removed.", "warning");
        return;
      }
      if (args.trim().length > 0) {
        ctx.ui.notify("Usage: /quality [revoke]", "warning");
        return;
      }
      await refreshDiff(ctx, true);
      await revalidateGate(ctx);
      const view = renderStatus(state, ctx);
      ctx.ui.notify(detailLines(view).join("\n"), view.gate === "GREEN" ? "info" : "warning");
    },
  });

  const reload = async (ctx: ContextLike): Promise<void> => {
    const root = safeContextRoot(ctx);
    let trusted = true;
    if (typeof ctx.isProjectTrusted === "function") {
      try {
        trusted = ctx.isProjectTrusted() === true;
      } catch {
        trusted = false;
      }
    }
    const config = await loadGovernorConfig(root, { trusted });
    state = initialState(config);
    restoreLatest(state, ctx);
    if (config.code !== undefined) state.violations.set(config.code, config.reason ?? "configuration fallback");
    state.pendingCalls.clear();
    state.completedMutations.clear();
    state.pendingHumanInputs = 0;
    reconcileTools(pi, state);
    renderStatus(state, ctx);
  };

  pi.on("session_start", async (_event, rawContext) => {
    await reload(rawContext as ContextLike);
  });

  pi.on("session_tree", async (_event, rawContext) => {
    await reload(rawContext as ContextLike);
  });

  pi.on("input", (event) => {
    const source = (event as InputEventLike).source;
    if (source === "interactive" || source === "rpc") state.pendingHumanInputs++;
  });

  pi.on("before_agent_start", (event) => {
    if (state.pendingHumanInputs <= 0) return;
    state.pendingHumanInputs--;
    state.humanTurn++;
    state.repairStatus = "eligible";
    state.repairAttempted = 0;
    state.terminalCandidate = false;
    const prompt = (event as BeforeAgentStartLike).prompt;
    const profile = classifyRequest(typeof prompt === "string" ? prompt : "").profile;
    rebuildVector(state);
    return {
      message: {
        customType: ENTRY_TYPE,
        content: `QUALITY_PROPOSAL profile=${profile}; ${compactStatus(statusView(state))}. ` +
          "Classification is advisory only; use quality_contract propose for interactive authority.",
        display: true,
        details: { profile, gate: state.gate, mode: state.mode },
      },
    };
  });

  pi.on("tool_call", async (event, rawContext) => {
    const value = event as ToolCallLike;
    const ctx = rawContext as ContextLike;
    if (typeof value.toolCallId !== "string" || typeof value.toolName !== "string") {
      return { block: true, reason: "QG-010 tool identity is missing or invalid" };
    }
    const existingPending = state.pendingCalls.get(value.toolCallId);
    if (existingPending !== undefined) return pendingResponse(existingPending);
    if (state.completedMutations.has(value.toolCallId)) {
      return { block: true, reason: "QG-010 completed mutation call ID cannot be replayed" };
    }

    const rawName = value.toolName;
    const name = normalizedToolName(rawName);
    if (name === "fabric_exec") {
      state.pendingCalls.set(value.toolCallId, { kind: "fabric" });
      return;
    }
    if (GOVERNOR_TOOLS.has(name)) {
      state.pendingCalls.set(value.toolCallId, { kind: name === "quality_check" ? "check" : "governor" });
      return;
    }

    const input = isRecord(value.input) ? value.input : {};
    const replayed = value.replayed === true || value.source === "fabric" || rawName.startsWith("pi.") || rawName.startsWith("extensions.");
    const identity = {
      kind: replayed ? "replayed" as const : "direct" as const,
      source: replayed ? "fabric" : "pi",
      toolName: rawName,
    };
    let effect = name;
    let targetEvidence: Awaited<ReturnType<typeof canonicalMutation>> = { pathVerified: false };
    let kind: PendingAdmission["kind"] = "other";
    if (name === "edit" || name === "write") {
      targetEvidence = await canonicalMutation(safeContextRoot(ctx), name, input);
      effect = name;
      kind = "mutation";
    } else if (["read", "grep", "find", "ls"].includes(name)) {
      kind = "read";
    }
    const policyDecision = decideAdmission({
      contract: state.contract,
      mode: state.mode,
      rollout: state.config.rollout,
      effect,
      toolName: rawName,
      toolCallId: value.toolCallId,
      identity,
      target: targetEvidence.target,
      targetExists: targetEvidence.targetExists,
      repositoryRoot: safeContextRoot(ctx),
      contentLength: targetEvidence.contentLength,
      pathVerified: kind === "mutation" ? targetEvidence.pathVerified : undefined,
      protectedPaths: state.config.protectedPaths,
      dependencyPaths: state.config.dependencyPaths,
    });
    const explicitlyRejected = policyDecision.code === "QG-005" && targetEvidence.target !== undefined &&
      state.rejectedExpansionTargets.has(targetEvidence.target);
    const rejectedDecision: AdmissionDecision = explicitlyRejected
      ? { ...policyDecision, admitted: false, greenEligible: false }
      : policyDecision;
    // Observe rollout admits every effect so successful mutations still invalidate receipts, while keeping the finding's code/reason for the quality vector.
    const decision: AdmissionDecision = state.config.rollout === "observe"
      ? { ...rejectedDecision, admitted: true, greenEligible: false }
      : rejectedDecision;
    const pending: PendingAdmission = { kind, decision };
    state.pendingCalls.set(value.toolCallId, pending);
    recordDecision(state, decision);
    renderStatus(state, ctx);
    if (!decision.admitted) {
      return { block: true, reason: `${decision.code ?? "QG-010"} ${decision.reason}` };
    }
  });

  pi.on("tool_result", (event, rawContext) => {
    const value = event as ToolResultLike;
    if (typeof value.toolCallId !== "string") return;
    const pending = state.pendingCalls.get(value.toolCallId);
    if (pending?.kind === "fabric" || normalizedToolName(String(value.toolName ?? "")) === "fabric_exec") {
      inspectFabricResult(state, value.details);
      state.pendingCalls.delete(value.toolCallId);
      renderStatus(state, rawContext as ContextLike);
      return;
    }
    if (pending?.kind !== "mutation" || value.isError === true) state.pendingCalls.delete(value.toolCallId);
  });

  pi.on("tool_execution_end", (event, rawContext) => {
    const value = event as ToolExecutionEndLike;
    if (typeof value.toolCallId !== "string") return;
    const pending = state.pendingCalls.get(value.toolCallId);
    if (pending?.kind !== "mutation") return;
    state.pendingCalls.delete(value.toolCallId);
    if (value.isError === true || pending.decision?.admitted !== true || state.completedMutations.has(value.toolCallId)) return;
    state.completedMutations.add(value.toolCallId);
    boundedCompletedSet(state);
    state.mutationRevision++;
    state.generation++;
    invalidateReceipts(state);
    rebuildVector(state);
    appendState();
    renderStatus(state, rawContext as ContextLike);
  });

  pi.on("turn_end", async (_event, rawContext) => {
    const ctx = rawContext as ContextLike;
    await refreshDiff(ctx);
    renderStatus(state, ctx);
  });

  pi.on("message_end", async (event, rawContext) => {
    const terminal = terminalTextMessage((event as MessageEndLike).message);
    if (terminal === null) return;
    const ctx = rawContext as ContextLike;
    await revalidateGate(ctx);
    renderStatus(state, ctx);
    if (state.gate === "GREEN") {
      state.terminalCandidate = false;
      return;
    }
    state.terminalCandidate = true;
    const annotation = `QUALITY_GATE ${state.gate} mode=${state.mode} freshness=${state.vector.verification} ` +
      `violations=${state.violations.size} bypasses=${state.bypasses.size}`;
    const replacement = {
      ...terminal.message,
      content: [...terminal.content, { type: "text", text: `\n\n${annotation}` }],
    };
    return { message: replacement, ...replacement };
  });

  pi.on("agent_settled", async (_event, rawContext) => {
    const ctx = rawContext as ContextLike;
    await refreshDiff(ctx);
    await revalidateGate(ctx);
    renderStatus(state, ctx);
    appendState();
    if (state.gate === "GREEN" || !state.terminalCandidate || state.humanTurn === 0) return;
    if (state.repairStatus !== "eligible") {
      if (state.repairStatus === "attempted") state.repairStatus = "exhausted";
      state.violations.set("QG-016", "automatic repair is exhausted or already terminal");
      rebuildVector(state);
      return;
    }

    let pending = state.pendingHumanInputs > 0;
    let idle = false;
    try {
      pending ||= ctx.hasPendingMessages();
      idle = ctx.isIdle();
    } catch {
      pending = true;
    }
    if (pending) {
      state.repairStatus = "skipped-pending-input";
      state.violations.set("QG-016", "automatic repair skipped because input is pending");
      rebuildVector(state);
      appendState();
      renderStatus(state, ctx);
      return;
    }
    if (!idle) {
      state.repairStatus = "skipped-busy";
      state.violations.set("QG-016", "automatic repair skipped because the agent is busy");
      rebuildVector(state);
      appendState();
      renderStatus(state, ctx);
      return;
    }
    const eligible = canDispatchRepair({
      repairable: true,
      attempted: state.repairAttempted,
      maximum: 1,
      idle,
      pendingInput: pending,
      terminal: state.terminalCandidate,
      dispatchStatus: state.repairStatus,
    });
    if (!eligible) {
      state.repairStatus = "exhausted";
      state.violations.set("QG-016", "automatic repair is ineligible or exhausted");
      rebuildVector(state);
      appendState();
      renderStatus(state, ctx);
      return;
    }

    state.repairAttempted = 1;
    state.repairStatus = "attempted";
    state.violations.set("QG-016", "one bounded repair was attempted");
    rebuildVector(state);
    appendState();
    renderStatus(state, ctx);
    try {
      await pi.sendMessage(
        {
          customType: ENTRY_TYPE,
          content: `Quality repair: gate=${state.gate}, freshness=${state.vector.verification}. ` +
            "Address only the confirmed scope, rerun declared checks, and return a terminal answer.",
          display: true,
          details: { gate: state.gate, code: "QG-016", contractRevision: state.contractRevision, mutationRevision: state.mutationRevision },
        },
        { deliverAs: "followUp", triggerTurn: true },
      );
      state.repairStatus = "dispatched";
      appendState();
    } catch {
      state.repairStatus = "dispatch-failed";
      state.violations.set("QG-016", "automatic repair dispatch failed terminally");
      rebuildVector(state);
      appendState();
    }
    renderStatus(state, ctx);
  });
}