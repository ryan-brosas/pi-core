import { spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { lstat, open, readFile, readlink, realpath, stat } from "node:fs/promises";
import { isAbsolute, join, relative, resolve, sep } from "node:path";

import type { VerificationState, ViolationCode } from "./policy.ts";

export interface CheckRecipe {
  readonly id: string;
  readonly version?: 1;
  readonly executable: string;
  readonly argv: readonly string[];
  readonly cwd: string;
  readonly timeoutMs?: number;
  readonly outputCap: number;
  readonly acceptedExits: readonly number[];
  readonly checkedPaths?: readonly string[];
  readonly applicability?: "always" | "changed-paths" | "public-api" | "architecture";
  readonly dimension?: "verification" | "publicApi" | "architecture";
  readonly recipeDigest?: string;
  readonly configDigest?: string;
}

export interface GovernorConfig {
  readonly version: 1;
  readonly enabled: true;
  readonly rollout: "observe";
  readonly maxRepairs: 1;
  readonly limits: {
    readonly maxPaths: number;
    readonly maxPathBytes: number;
    readonly maxGitOutputBytes: number;
    readonly maxTrackedDiffBytes: number;
    readonly maxUntrackedFileBytes: number;
    readonly maxUntrackedBytes: number;
    readonly maxCheckOutputBytes: number;
    readonly maxCheckTimeoutMs: number;
  };
  readonly protectedPaths: readonly string[];
  readonly dependencyPaths: readonly string[];
  readonly tools: {
    readonly PLAN: readonly string[];
    readonly BUILD: readonly string[];
    readonly VERIFY: readonly string[];
  };
  readonly recipes: readonly CheckRecipe[];
  readonly source: "built-in" | "project";
  readonly configDigest: string;
  readonly code?: ViolationCode;
  readonly reason?: string;
}

export interface DiffEvidence {
  readonly state: "CURRENT" | "UNKNOWN";
  readonly complete: boolean;
  readonly canonicalRoot?: string;
  readonly head?: string;
  readonly changedPaths: readonly string[];
  readonly newFiles: readonly string[];
  readonly deletedFiles: readonly string[];
  readonly outOfScope: readonly string[];
  readonly protectedPaths: readonly string[];
  readonly dependencyPaths: readonly string[];
  readonly additions: number | null;
  readonly deletions: number | null;
  readonly status: readonly {
    readonly code: string;
    readonly path: string;
    readonly originalPath?: string;
  }[];
  readonly unavailable: readonly string[];
}

export interface RepositoryFingerprint {
  readonly version: 1;
  readonly state: "CURRENT" | "UNKNOWN";
  readonly complete: boolean;
  readonly digest: string;
  readonly canonicalRoot?: string;
  readonly head?: string;
  readonly selectedPaths: readonly string[];
  readonly configDigest?: string;
  readonly bytesHashed: number;
  readonly unavailable: readonly string[];
}

export interface CheckReceipt {
  readonly state: VerificationState;
  readonly code?: ViolationCode;
  readonly reason?: string;
  readonly contractRevision: number;
  readonly mutationRevision: number;
  readonly recipeId: string;
  readonly recipeVersion?: number;
  readonly recipeDigest?: string;
  readonly configDigest?: string;
  readonly checkedPaths: readonly string[];
  readonly fingerprint: string;
  readonly preFingerprint?: string;
  readonly currentFingerprint?: string;
  readonly exitCode?: number | null;
  readonly signal?: string | null;
  readonly timedOut?: boolean;
  readonly cancelled?: boolean;
  readonly outputDigest?: string;
  readonly stdoutExcerpt?: string;
  readonly stderrExcerpt?: string;
  readonly outputTruncated?: boolean;
}

const PATH_MAX_BYTES = 1024;
const WILDCARD_RE = /[*?\[\]{}]/;

function failureReason(error: unknown): string {
  if (error instanceof Error && error.message.length > 0) return error.message.slice(0, 256);
  return "operation unavailable";
}

function utf8Length(value: string): number {
  return Buffer.byteLength(value, "utf8");
}

function parseRepositoryPath(
  value: unknown,
  allowDescendants: boolean,
  maximumBytes = PATH_MAX_BYTES,
): { readonly path: string; readonly descendants: boolean } | null {
  if (typeof value !== "string" || value.length === 0 || value !== value.trim()) return null;
  if (utf8Length(value) > maximumBytes || value.includes("\0") || value.includes("\\")) return null;
  if (value.startsWith("/") || /^[A-Za-z]:/.test(value) || value.endsWith("/")) return null;

  const descendantSuffix = "/**";
  const descendants = allowDescendants && value.endsWith(descendantSuffix);
  const path = descendants ? value.slice(0, -descendantSuffix.length) : value;
  if (path.length === 0 || WILDCARD_RE.test(path) || (!descendants && WILDCARD_RE.test(value))) {
    return null;
  }
  const segments = path.split("/");
  if (segments.some((segment) => segment.length === 0 || segment === "." || segment === "..")) {
    return null;
  }
  return { path, descendants };
}

function isWithinRoot(root: string, candidate: string, allowRoot: boolean): boolean {
  const boundary = relative(root, candidate);
  if (boundary === "") return allowRoot;
  return boundary !== ".." && !boundary.startsWith(`..${sep}`) && !isAbsolute(boundary);
}

function toRepositoryPath(root: string, candidate: string): string {
  return relative(root, candidate).split(sep).join("/");
}

/** Canonicalize one strict repository-relative mutation target without creating it. */
export async function canonicalizeTarget(
  root: string,
  target: string,
  exists: boolean,
): Promise<
  | {
      readonly ok: true;
      readonly canonicalRoot: string;
      readonly canonicalTarget: string;
      readonly relativeTarget: string;
      readonly exists: boolean;
    }
  | { readonly ok: false; readonly code: "QG-009"; readonly reason: string }
> {
  const parsed = parseRepositoryPath(target, false);
  if (parsed === null || typeof root !== "string" || root.length === 0 || typeof exists !== "boolean") {
    return { ok: false, code: "QG-009", reason: "target must be a strict repository-relative path" };
  }

  try {
    const canonicalRoot = await realpath(root);
    if (!(await stat(canonicalRoot)).isDirectory()) {
      return { ok: false, code: "QG-009", reason: "repository root is not a directory" };
    }

    const lexicalTarget = resolve(canonicalRoot, ...parsed.path.split("/"));
    if (!isWithinRoot(canonicalRoot, lexicalTarget, false)) {
      return { ok: false, code: "QG-009", reason: "target escapes the repository" };
    }

    let canonicalTarget: string;
    if (exists) {
      canonicalTarget = await realpath(lexicalTarget);
      if (!(await stat(canonicalTarget)).isFile()) {
        return { ok: false, code: "QG-009", reason: "existing target must be a regular file" };
      }
    } else {
      try {
        await lstat(lexicalTarget);
        return { ok: false, code: "QG-009", reason: "new target already exists" };
      } catch (error) {
        const errorCode =
          typeof error === "object" && error !== null && "code" in error
            ? Reflect.get(error, "code")
            : undefined;
        if (errorCode !== "ENOENT") throw error;
      }
      const slash = parsed.path.lastIndexOf("/");
      const parentPath = slash === -1 ? "" : parsed.path.slice(0, slash);
      const baseName = slash === -1 ? parsed.path : parsed.path.slice(slash + 1);
      const lexicalParent = parentPath.length === 0
        ? canonicalRoot
        : resolve(canonicalRoot, ...parentPath.split("/"));
      const canonicalParent = await realpath(lexicalParent);
      if (!(await stat(canonicalParent)).isDirectory()) {
        return { ok: false, code: "QG-009", reason: "new target parent is not a directory" };
      }
      if (!isWithinRoot(canonicalRoot, canonicalParent, true)) {
        return { ok: false, code: "QG-009", reason: "new target parent escapes the repository" };
      }
      canonicalTarget = join(canonicalParent, baseName);
    }

    if (!isWithinRoot(canonicalRoot, canonicalTarget, false)) {
      return { ok: false, code: "QG-009", reason: "canonical target escapes the repository" };
    }
    return {
      ok: true,
      canonicalRoot,
      canonicalTarget,
      relativeTarget: toRepositoryPath(canonicalRoot, canonicalTarget),
      exists,
    };
  } catch (error) {
    return {
      ok: false,
      code: "QG-009",
      reason: `target path is unverifiable: ${failureReason(error)}`,
    };
  }
}

const DEFAULT_LIMITS: GovernorConfig["limits"] = Object.freeze({
  maxPaths: 4096,
  maxPathBytes: PATH_MAX_BYTES,
  maxGitOutputBytes: 1024 * 1024,
  maxTrackedDiffBytes: 4 * 1024 * 1024,
  maxUntrackedFileBytes: 1024 * 1024,
  maxUntrackedBytes: 4 * 1024 * 1024,
  maxCheckOutputBytes: 256 * 1024,
  maxCheckTimeoutMs: 120_000,
});

interface CapturedProcess {
  readonly exitCode: number | null;
  readonly signal: string | null;
  readonly timedOut: boolean;
  readonly cancelled: boolean;
  readonly overflow: boolean;
  readonly spawnError?: string;
  readonly stdout: Buffer;
  readonly stderr: Buffer;
  readonly outputDigest: string;
}

interface GitResult {
  readonly ok: boolean;
  readonly stdout: Buffer;
  readonly reason?: string;
}

interface ParsedStatus {
  readonly entries: Array<{ code: string; path: string; originalPath?: string }>;
  readonly untracked: string[];
}

interface UntrackedInspection {
  readonly ok: boolean;
  readonly digest?: string;
  readonly bytes: number;
  readonly lines: number | null;
  readonly kind?: "file" | "symlink";
  readonly reason?: string;
}

function compareStrings(left: string, right: string): number {
  return left < right ? -1 : left > right ? 1 : 0;
}

function sortedUnique(values: Iterable<string>): string[] {
  return [...new Set(values)].sort(compareStrings);
}

function validPositiveBound(value: unknown, hardMaximum: number): value is number {
  return Number.isSafeInteger(value) && (value as number) > 0 && (value as number) <= hardMaximum;
}

function sensorLimits(
  input?: Partial<GovernorConfig["limits"]> & Record<string, unknown>,
): GovernorConfig["limits"] | null {
  if (input === undefined) return DEFAULT_LIMITS;
  const result: Record<keyof GovernorConfig["limits"], number> = { ...DEFAULT_LIMITS };
  for (const key of Object.keys(DEFAULT_LIMITS) as Array<keyof GovernorConfig["limits"]>) {
    const supplied = input[key];
    if (supplied === undefined) continue;
    if (!validPositiveBound(supplied, DEFAULT_LIMITS[key])) return null;
    result[key] = supplied;
  }
  if (result.maxUntrackedFileBytes > result.maxUntrackedBytes) return null;
  return Object.freeze(result);
}

function sha256(value: string | Buffer): string {
  return createHash("sha256").update(value).digest("hex");
}

function updateFramed(
  hash: ReturnType<typeof createHash>,
  label: string,
  value: string | Buffer,
): number {
  const bytes = typeof value === "string" ? Buffer.from(value, "utf8") : value;
  hash.update(Buffer.from(`${label}\0${bytes.length}\0`, "utf8"));
  hash.update(bytes);
  hash.update("\0");
  return bytes.length;
}

function outputDigest(stdoutDigest: string, stderrDigest: string): string {
  const hash = createHash("sha256");
  updateFramed(hash, "version", "quality-governor-output-v1");
  updateFramed(hash, "stdout", stdoutDigest);
  updateFramed(hash, "stderr", stderrDigest);
  return hash.digest("hex");
}

async function runArgv(
  executable: string,
  argv: readonly string[],
  options: {
    readonly cwd: string;
    readonly timeoutMs: number;
    readonly outputCap: number;
    readonly signal?: AbortSignal;
  },
): Promise<CapturedProcess> {
  if (options.signal?.aborted) {
    const empty = sha256(Buffer.alloc(0));
    return {
      exitCode: null,
      signal: null,
      timedOut: false,
      cancelled: true,
      overflow: false,
      stdout: Buffer.alloc(0),
      stderr: Buffer.alloc(0),
      outputDigest: outputDigest(empty, empty),
    };
  }

  return new Promise((complete) => {
    let child: ReturnType<typeof spawn>;
    try {
      child = spawn(executable, [...argv], {
        cwd: options.cwd,
        shell: false,
        windowsHide: true,
        stdio: ["ignore", "pipe", "pipe"],
        env: { ...process.env, GIT_OPTIONAL_LOCKS: "0", LC_ALL: "C" },
      });
    } catch (error) {
      const empty = sha256(Buffer.alloc(0));
      complete({
        exitCode: null,
        signal: null,
        timedOut: false,
        cancelled: false,
        overflow: false,
        spawnError: failureReason(error),
        stdout: Buffer.alloc(0),
        stderr: Buffer.alloc(0),
        outputDigest: outputDigest(empty, empty),
      });
      return;
    }

    const stdoutChunks: Buffer[] = [];
    const stderrChunks: Buffer[] = [];
    const stdoutHash = createHash("sha256");
    const stderrHash = createHash("sha256");
    let retainedBytes = 0;
    let totalBytes = 0;
    let overflow = false;
    let timedOut = false;
    let cancelled = false;
    let spawnError: string | undefined;
    let killTimer: NodeJS.Timeout | undefined;
    let stopRequested = false;
    let settled = false;

    const stop = (): void => {
      if (stopRequested || child.exitCode !== null || child.signalCode !== null) return;
      stopRequested = true;
      child.kill("SIGTERM");
      killTimer = setTimeout(() => {
        if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
      }, 250);
      killTimer.unref();
    };

    const capture = (stream: "stdout" | "stderr", chunk: Buffer | string): void => {
      const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
      if (stream === "stdout") stdoutHash.update(bytes);
      else stderrHash.update(bytes);
      totalBytes += bytes.length;

      const remaining = Math.max(0, options.outputCap - retainedBytes);
      if (remaining > 0) {
        const retained = bytes.length <= remaining ? bytes : bytes.subarray(0, remaining);
        if (stream === "stdout") stdoutChunks.push(Buffer.from(retained));
        else stderrChunks.push(Buffer.from(retained));
        retainedBytes += retained.length;
      }
      if (totalBytes > options.outputCap && !overflow) {
        overflow = true;
        stop();
      }
    };

    child.stdout?.on("data", (chunk: Buffer | string) => capture("stdout", chunk));
    child.stderr?.on("data", (chunk: Buffer | string) => capture("stderr", chunk));
    child.once("error", (error) => {
      spawnError = failureReason(error);
    });

    const timeout = setTimeout(() => {
      timedOut = true;
      stop();
    }, options.timeoutMs);
    timeout.unref();

    const onAbort = (): void => {
      cancelled = true;
      stop();
    };
    options.signal?.addEventListener("abort", onAbort, { once: true });

    child.once("close", (exitCode, signal) => {
      if (settled) return;
      settled = true;
      clearTimeout(timeout);
      if (killTimer !== undefined) clearTimeout(killTimer);
      options.signal?.removeEventListener("abort", onAbort);
      const stdoutHashValue = stdoutHash.digest("hex");
      const stderrHashValue = stderrHash.digest("hex");
      complete({
        exitCode,
        signal,
        timedOut,
        cancelled,
        overflow,
        ...(spawnError === undefined ? {} : { spawnError }),
        stdout: Buffer.concat(stdoutChunks),
        stderr: Buffer.concat(stderrChunks),
        outputDigest: outputDigest(stdoutHashValue, stderrHashValue),
      });
    });
  });
}

async function runGit(
  root: string,
  argv: readonly string[],
  outputCap: number,
): Promise<GitResult> {
  const outcome = await runArgv("git", argv, {
    cwd: root,
    timeoutMs: Math.min(30_000, DEFAULT_LIMITS.maxCheckTimeoutMs),
    outputCap,
  });
  if (
    outcome.exitCode !== 0 ||
    outcome.signal !== null ||
    outcome.timedOut ||
    outcome.cancelled ||
    outcome.overflow ||
    outcome.spawnError !== undefined
  ) {
    return { ok: false, stdout: Buffer.alloc(0), reason: `git ${argv[0] ?? "command"} unavailable` };
  }
  return { ok: true, stdout: outcome.stdout };
}

function decodeGitField(field: Buffer): string | null {
  const decoded = field.toString("utf8");
  return Buffer.from(decoded, "utf8").equals(field) ? decoded : null;
}

function safeGitPath(path: string, maximumBytes: number): boolean {
  if (path.length === 0 || utf8Length(path) > maximumBytes || path.includes("\0")) return false;
  if (path.startsWith("/") || /^[A-Za-z]:/.test(path)) return false;
  const segments = path.split("/");
  return !segments.some((segment) => segment.length === 0 || segment === "." || segment === "..");
}

function parsePorcelainStatus(
  raw: Buffer,
  limits: GovernorConfig["limits"],
): ParsedStatus | null {
  const records = raw.length === 0 ? [] : raw.subarray(0, raw[raw.length - 1] === 0 ? raw.length - 1 : raw.length).toString("binary").split("\0");
  const entries: Array<{ code: string; path: string; originalPath?: string }> = [];
  const untracked: string[] = [];

  for (let index = 0; index < records.length; index++) {
    const bytes = Buffer.from(records[index] ?? "", "binary");
    if (bytes.length < 4 || bytes[2] !== 0x20) return null;
    const decoded = decodeGitField(bytes);
    if (decoded === null) return null;
    const code = decoded.slice(0, 2);
    const path = decoded.slice(3);
    if (!safeGitPath(path, limits.maxPathBytes)) return null;

    let originalPath: string | undefined;
    if (code.includes("R") || code.includes("C")) {
      index++;
      const originalRecord = records[index];
      if (originalRecord === undefined) return null;
      const originalBytes = Buffer.from(originalRecord, "binary");
      originalPath = decodeGitField(originalBytes) ?? undefined;
      if (originalPath === undefined || !safeGitPath(originalPath, limits.maxPathBytes)) return null;
    }

    entries.push({ code, path, ...(originalPath === undefined ? {} : { originalPath }) });
    if (code === "??") untracked.push(path);
    if (entries.length > limits.maxPaths) return null;
  }
  return { entries, untracked };
}

function parseNameStatus(raw: Buffer, limits: GovernorConfig["limits"]): string[] | null {
  if (raw.length === 0) return [];
  const body = raw.subarray(0, raw[raw.length - 1] === 0 ? raw.length - 1 : raw.length);
  const fields = body.toString("binary").split("\0");
  const paths: string[] = [];
  for (let index = 0; index < fields.length; index++) {
    const fieldBytes = Buffer.from(fields[index] ?? "", "binary");
    const field = decodeGitField(fieldBytes);
    if (field === null) return null;
    const tab = field.indexOf("\t");
    let code: string;
    let firstPath: string | undefined;
    if (tab >= 0) {
      code = field.slice(0, tab);
      firstPath = field.slice(tab + 1);
    } else {
      code = field;
    }
    const path = firstPath ?? (() => {
      index++;
      const next = fields[index];
      return next === undefined ? undefined : decodeGitField(Buffer.from(next, "binary")) ?? undefined;
    })();
    if (path === undefined || !safeGitPath(path, limits.maxPathBytes)) return null;
    paths.push(path);
    if (code.startsWith("R") || code.startsWith("C")) {
      index++;
      const next = fields[index];
      const second = next === undefined ? undefined : decodeGitField(Buffer.from(next, "binary")) ?? undefined;
      if (second === undefined || !safeGitPath(second, limits.maxPathBytes)) return null;
      paths.push(second);
    }
    if (paths.length > limits.maxPaths) return null;
  }
  return paths;
}

function parseNumstat(
  raw: Buffer,
  limits: GovernorConfig["limits"],
): { readonly additions: number; readonly deletions: number } | null {
  if (raw.length === 0) return { additions: 0, deletions: 0 };
  const body = raw.subarray(0, raw[raw.length - 1] === 0 ? raw.length - 1 : raw.length);
  const records = body.toString("binary").split("\0");
  let additions = 0;
  let deletions = 0;
  let count = 0;
  for (const recordValue of records) {
    const recordBytes = Buffer.from(recordValue, "binary");
    const record = decodeGitField(recordBytes);
    if (record === null) return null;
    const firstTab = record.indexOf("\t");
    const secondTab = firstTab < 0 ? -1 : record.indexOf("\t", firstTab + 1);
    if (firstTab < 1 || secondTab < 0) return null;
    const added = record.slice(0, firstTab);
    const deleted = record.slice(firstTab + 1, secondTab);
    const path = record.slice(secondTab + 1);
    if (added === "-" || deleted === "-" || !/^\d+$/.test(added) || !/^\d+$/.test(deleted)) {
      return null;
    }
    if (!safeGitPath(path, limits.maxPathBytes)) return null;
    const addedNumber = Number(added);
    const deletedNumber = Number(deleted);
    if (!Number.isSafeInteger(addedNumber) || !Number.isSafeInteger(deletedNumber)) return null;
    additions += addedNumber;
    deletions += deletedNumber;
    if (!Number.isSafeInteger(additions) || !Number.isSafeInteger(deletions)) return null;
    count++;
    if (count > limits.maxPaths) return null;
  }
  return { additions, deletions };
}

function countTextLines(bytes: Buffer): number | null {
  if (bytes.includes(0)) return null;
  if (bytes.length === 0) return 0;
  let lines = 0;
  for (const byte of bytes) if (byte === 0x0a) lines++;
  if (bytes[bytes.length - 1] !== 0x0a) lines++;
  return lines;
}

async function inspectUntracked(
  root: string,
  path: string,
  maximumFileBytes: number,
): Promise<UntrackedInspection> {
  try {
    if (!safeGitPath(path, PATH_MAX_BYTES)) {
      return { ok: false, bytes: 0, lines: null, reason: "unsafe untracked path" };
    }
    const absolute = resolve(root, ...path.split("/"));
    if (!isWithinRoot(root, absolute, false)) {
      return { ok: false, bytes: 0, lines: null, reason: "untracked path escapes repository" };
    }
    const pathStat = await lstat(absolute, { bigint: true });
    if (pathStat.isSymbolicLink()) {
      const linkTarget = await readlink(absolute, { encoding: "buffer" });
      if (linkTarget.length > maximumFileBytes) {
        return { ok: false, bytes: linkTarget.length, lines: null, reason: "untracked symlink exceeds bound" };
      }
      const confirmed = await lstat(absolute, { bigint: true });
      if (confirmed.ino !== pathStat.ino || confirmed.mtimeNs !== pathStat.mtimeNs) {
        return { ok: false, bytes: linkTarget.length, lines: null, reason: "untracked symlink changed while hashing" };
      }
      const hash = createHash("sha256");
      updateFramed(hash, "kind", "symlink");
      updateFramed(hash, "content", linkTarget);
      return {
        ok: true,
        digest: hash.digest("hex"),
        bytes: linkTarget.length,
        lines: countTextLines(linkTarget),
        kind: "symlink",
      };
    }
    if (!pathStat.isFile()) {
      return { ok: false, bytes: 0, lines: null, reason: "untracked path is not a regular file" };
    }
    if (pathStat.size > BigInt(maximumFileBytes) || pathStat.size > BigInt(Number.MAX_SAFE_INTEGER)) {
      return { ok: false, bytes: Number(pathStat.size), lines: null, reason: "untracked file exceeds bound" };
    }

    const handle = await open(absolute, "r");
    try {
      const opened = await handle.stat({ bigint: true });
      if (!opened.isFile() || opened.size !== pathStat.size || opened.ino !== pathStat.ino) {
        return { ok: false, bytes: 0, lines: null, reason: "untracked file changed before hashing" };
      }
      const size = Number(opened.size);
      const contentHash = createHash("sha256");
      let offset = 0;
      let lineBreaks = 0;
      let containsNul = false;
      let finalByte: number | undefined;
      while (offset < size) {
        const chunk = Buffer.allocUnsafe(Math.min(64 * 1024, size - offset));
        const { bytesRead } = await handle.read(chunk, 0, chunk.length, offset);
        if (bytesRead === 0) break;
        const used = chunk.subarray(0, bytesRead);
        contentHash.update(used);
        for (const byte of used) {
          if (byte === 0) containsNul = true;
          if (byte === 0x0a) lineBreaks++;
        }
        finalByte = used[used.length - 1];
        offset += bytesRead;
      }
      const closedState = await handle.stat({ bigint: true });
      if (
        offset !== size ||
        closedState.size !== opened.size ||
        closedState.mtimeNs !== opened.mtimeNs ||
        closedState.ctimeNs !== opened.ctimeNs ||
        closedState.ino !== opened.ino
      ) {
        return { ok: false, bytes: offset, lines: null, reason: "untracked file changed while hashing" };
      }
      const hash = createHash("sha256");
      updateFramed(hash, "kind", "file");
      updateFramed(hash, "content-digest", contentHash.digest("hex"));
      return {
        ok: true,
        digest: hash.digest("hex"),
        bytes: offset,
        lines: containsNul ? null : offset === 0 ? 0 : lineBreaks + (finalByte === 0x0a ? 0 : 1),
        kind: "file",
      };
    } finally {
      await handle.close();
    }
  } catch (error) {
    return { ok: false, bytes: 0, lines: null, reason: failureReason(error) };
  }
}

function pathRuleMatches(rule: string, target: string): boolean {
  const parsed = parseRepositoryPath(rule, true);
  if (parsed === null) return false;
  return parsed.descendants ? target.startsWith(`${parsed.path}/`) : target === parsed.path;
}

function validatePathRules(
  values: readonly string[] | undefined,
  maximumPaths: number,
  maximumBytes: number,
): string[] | null {
  if (!Array.isArray(values) || values.length > maximumPaths) return null;
  const normalized: string[] = [];
  const seen = new Set<string>();
  for (const value of values) {
    const parsed = parseRepositoryPath(value, true, maximumBytes);
    if (parsed === null) return null;
    const rule = parsed.descendants ? `${parsed.path}/**` : parsed.path;
    if (seen.has(rule)) return null;
    seen.add(rule);
    normalized.push(rule);
  }
  return normalized.sort(compareStrings);
}

function unavailableDiff(reason: string): DiffEvidence {
  return {
    state: "UNKNOWN",
    complete: false,
    changedPaths: [],
    newFiles: [],
    deletedFiles: [],
    outOfScope: [],
    protectedPaths: [],
    dependencyPaths: [],
    additions: null,
    deletions: null,
    status: [],
    unavailable: [reason.slice(0, 256)],
  };
}

/** Collect bounded, NUL-safe Git evidence for tracked and untracked repository changes. */
export async function collectDiffEvidence(
  root: string,
  options: {
    readonly ownedPaths: readonly string[];
    readonly protectedPaths?: readonly string[];
    readonly dependencyPaths?: readonly string[];
    readonly limits?: Partial<GovernorConfig["limits"]>;
    readonly maxPaths?: number;
    readonly maxPathBytes?: number;
    readonly maxGitOutputBytes?: number;
    readonly maxUntrackedFileBytes?: number;
    readonly maxUntrackedBytes?: number;
  },
): Promise<DiffEvidence> {
  const requestedLimits = {
    ...(options?.limits ?? {}),
    ...(options?.maxPaths === undefined ? {} : { maxPaths: options.maxPaths }),
    ...(options?.maxPathBytes === undefined ? {} : { maxPathBytes: options.maxPathBytes }),
    ...(options?.maxGitOutputBytes === undefined ? {} : { maxGitOutputBytes: options.maxGitOutputBytes }),
    ...(options?.maxUntrackedFileBytes === undefined ? {} : { maxUntrackedFileBytes: options.maxUntrackedFileBytes }),
    ...(options?.maxUntrackedBytes === undefined ? {} : { maxUntrackedBytes: options.maxUntrackedBytes }),
  };
  const limits = sensorLimits(requestedLimits);
  if (limits === null) return unavailableDiff("sensor limits are invalid or weakened");

  const ownedPaths = validatePathRules(options?.ownedPaths, limits.maxPaths, limits.maxPathBytes);
  const protectedRules = validatePathRules(options?.protectedPaths ?? [], limits.maxPaths, limits.maxPathBytes);
  const dependencyRules = validatePathRules(options?.dependencyPaths ?? [], limits.maxPaths, limits.maxPathBytes);
  if (ownedPaths === null || protectedRules === null || dependencyRules === null) {
    return unavailableDiff("scope path rules are invalid");
  }

  try {
    const canonicalRoot = await realpath(root);
    if (!(await stat(canonicalRoot)).isDirectory()) return unavailableDiff("repository root is not a directory");

    const topLevel = await runGit(canonicalRoot, ["rev-parse", "--show-toplevel"], limits.maxGitOutputBytes);
    if (!topLevel.ok) return unavailableDiff(topLevel.reason ?? "Git root is unavailable");
    const reportedRoot = await realpath(topLevel.stdout.toString("utf8").replace(/\r?\n$/, ""));
    if (reportedRoot !== canonicalRoot) return unavailableDiff("configured root is not the Git repository root");

    const [headResult, statusResult, nameStatusResult, numstatResult] = await Promise.all([
      runGit(canonicalRoot, ["rev-parse", "--verify", "HEAD"], limits.maxGitOutputBytes),
      runGit(canonicalRoot, ["status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames", "--"], limits.maxGitOutputBytes),
      runGit(canonicalRoot, ["diff", "--name-status", "-z", "--no-renames", "HEAD", "--"], limits.maxGitOutputBytes),
      runGit(canonicalRoot, ["diff", "--numstat", "-z", "--no-renames", "HEAD", "--"], limits.maxGitOutputBytes),
    ]);
    if (!headResult.ok || !statusResult.ok || !nameStatusResult.ok || !numstatResult.ok) {
      return unavailableDiff("one or more bounded Git sensors are unavailable");
    }

    const head = headResult.stdout.toString("utf8").replace(/\r?\n$/, "");
    if (!/^[0-9a-fA-F]{40,64}$/.test(head)) return unavailableDiff("Git HEAD identity is invalid");
    const parsedStatus = parsePorcelainStatus(statusResult.stdout, limits);
    const nameStatusPaths = parseNameStatus(nameStatusResult.stdout, limits);
    const numstat = parseNumstat(numstatResult.stdout, limits);
    if (parsedStatus === null || nameStatusPaths === null) {
      return unavailableDiff("NUL-safe Git path evidence is invalid or exceeds bounds");
    }

    const changed = new Set<string>(nameStatusPaths);
    const newFiles = new Set<string>();
    const deletedFiles = new Set<string>();
    for (const entry of parsedStatus.entries) {
      changed.add(entry.path);
      if (entry.originalPath !== undefined) changed.add(entry.originalPath);
      if (entry.code === "??" || entry.code.includes("A") || entry.code.includes("C")) {
        newFiles.add(entry.path);
      }
      if (entry.code.includes("D")) deletedFiles.add(entry.path);
      if (entry.code.includes("R") && entry.originalPath !== undefined) {
        deletedFiles.add(entry.originalPath);
        newFiles.add(entry.path);
      }
    }
    if (changed.size > limits.maxPaths) return unavailableDiff("changed path count exceeds the configured bound");

    const unavailable: string[] = [];
    let additions = numstat?.additions ?? null;
    let deletions = numstat?.deletions ?? null;
    if (numstat === null) unavailable.push("tracked numstat evidence is unavailable");
    let untrackedBytes = 0;
    for (const path of sortedUnique(parsedStatus.untracked)) {
      const inspected = await inspectUntracked(canonicalRoot, path, limits.maxUntrackedFileBytes);
      untrackedBytes += inspected.bytes;
      if (untrackedBytes > limits.maxUntrackedBytes) {
        unavailable.push("untracked content exceeds the aggregate bound");
        additions = null;
        deletions = null;
        break;
      }
      if (!inspected.ok || inspected.lines === null || additions === null) {
        unavailable.push(`untracked line evidence unavailable for ${path}`);
        additions = null;
        deletions = null;
        continue;
      }
      additions += inspected.lines;
      if (!Number.isSafeInteger(additions)) {
        unavailable.push("line additions exceed the safe integer bound");
        additions = null;
        deletions = null;
      }
    }

    const changedPaths = sortedUnique(changed);
    const outOfScope = changedPaths.filter((path) => !ownedPaths.some((rule) => pathRuleMatches(rule, path)));
    const protectedPaths = changedPaths.filter((path) => protectedRules.some((rule) => pathRuleMatches(rule, path)));
    const dependencyPaths = changedPaths.filter((path) => dependencyRules.some((rule) => pathRuleMatches(rule, path)));
    const statusEntries = [...parsedStatus.entries].sort((left, right) => {
      const pathOrder = compareStrings(left.path, right.path);
      return pathOrder !== 0 ? pathOrder : compareStrings(left.code, right.code);
    });
    const complete = unavailable.length === 0 && additions !== null && deletions !== null;
    return {
      state: complete ? "CURRENT" : "UNKNOWN",
      complete,
      canonicalRoot,
      head: head.toLowerCase(),
      changedPaths,
      newFiles: sortedUnique(newFiles),
      deletedFiles: sortedUnique(deletedFiles),
      outOfScope,
      protectedPaths,
      dependencyPaths,
      additions,
      deletions,
      status: statusEntries,
      unavailable: sortedUnique(unavailable),
    };
  } catch (error) {
    return unavailableDiff(`diff evidence unavailable: ${failureReason(error)}`);
  }
}

function normalizeSelectedPaths(
  paths: readonly string[],
  limits: GovernorConfig["limits"],
): string[] | null {
  return validatePathRules(paths, limits.maxPaths, limits.maxPathBytes);
}

function fingerprintPathspecs(selectedPaths: readonly string[]): string[] {
  return selectedPaths.map((rule) => rule.endsWith("/**") ? rule.slice(0, -3) : rule);
}

function unknownFingerprint(
  selectedPaths: readonly string[],
  unavailable: readonly string[],
  configDigest?: string,
): RepositoryFingerprint {
  const reasons = sortedUnique(unavailable.map((reason) => reason.slice(0, 256)));
  const hash = createHash("sha256");
  updateFramed(hash, "version", "quality-governor-repository-fingerprint-v1-unknown");
  updateFramed(hash, "paths", selectedPaths.join("\0"));
  updateFramed(hash, "unavailable", reasons.join("\0"));
  if (configDigest !== undefined) updateFramed(hash, "config", configDigest);
  return {
    version: 1,
    state: "UNKNOWN",
    complete: false,
    digest: hash.digest("hex"),
    selectedPaths: [...selectedPaths],
    ...(configDigest === undefined ? {} : { configDigest }),
    bytesHashed: 0,
    unavailable: reasons,
  };
}

/** Fingerprint complete relevant Git and untracked content state; truncated evidence is UNKNOWN. */
export async function fingerprintRepository(
  root: string,
  selectedPaths: readonly string[],
  options: {
    readonly configDigest?: string;
    readonly limits?: Partial<GovernorConfig["limits"]>;
    readonly maxPaths?: number;
    readonly maxPathBytes?: number;
    readonly maxGitOutputBytes?: number;
    readonly maxTrackedDiffBytes?: number;
    readonly maxUntrackedFileBytes?: number;
    readonly maxUntrackedBytes?: number;
  } = {},
): Promise<RepositoryFingerprint> {
  const requestedLimits = {
    ...(options.limits ?? {}),
    ...(options.maxPaths === undefined ? {} : { maxPaths: options.maxPaths }),
    ...(options.maxPathBytes === undefined ? {} : { maxPathBytes: options.maxPathBytes }),
    ...(options.maxGitOutputBytes === undefined ? {} : { maxGitOutputBytes: options.maxGitOutputBytes }),
    ...(options.maxTrackedDiffBytes === undefined ? {} : { maxTrackedDiffBytes: options.maxTrackedDiffBytes }),
    ...(options.maxUntrackedFileBytes === undefined ? {} : { maxUntrackedFileBytes: options.maxUntrackedFileBytes }),
    ...(options.maxUntrackedBytes === undefined ? {} : { maxUntrackedBytes: options.maxUntrackedBytes }),
  };
  const limits = sensorLimits(requestedLimits);
  if (limits === null) return unknownFingerprint([], ["fingerprint limits are invalid or weakened"]);
  const normalizedPaths = normalizeSelectedPaths(selectedPaths, limits);
  if (normalizedPaths === null) return unknownFingerprint([], ["selected fingerprint paths are invalid"]);
  if (options.configDigest !== undefined && !/^[0-9a-f]{64}$/.test(options.configDigest)) {
    return unknownFingerprint(normalizedPaths, ["configuration digest is invalid"]);
  }

  try {
    const canonicalRoot = await realpath(root);
    if (!(await stat(canonicalRoot)).isDirectory()) {
      return unknownFingerprint(normalizedPaths, ["repository root is not a directory"], options.configDigest);
    }
    const topLevel = await runGit(canonicalRoot, ["rev-parse", "--show-toplevel"], limits.maxGitOutputBytes);
    if (!topLevel.ok) return unknownFingerprint(normalizedPaths, ["Git root is unavailable"], options.configDigest);
    const reportedRoot = await realpath(topLevel.stdout.toString("utf8").replace(/\r?\n$/, ""));
    if (reportedRoot !== canonicalRoot) {
      return unknownFingerprint(normalizedPaths, ["configured root is not the Git repository root"], options.configDigest);
    }

    const pathspecs = fingerprintPathspecs(normalizedPaths);
    const suffix = ["--", ...pathspecs];
    const capture = async () => Promise.all([
      runGit(canonicalRoot, ["rev-parse", "--verify", "HEAD"], limits.maxGitOutputBytes),
      runGit(canonicalRoot, ["status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames", ...suffix], limits.maxGitOutputBytes),
      runGit(canonicalRoot, ["diff", "--name-status", "-z", "--no-renames", "HEAD", ...suffix], limits.maxGitOutputBytes),
      runGit(canonicalRoot, ["diff", "--numstat", "-z", "--no-renames", "HEAD", ...suffix], limits.maxGitOutputBytes),
      runGit(canonicalRoot, ["diff", "--binary", "--no-ext-diff", "--no-textconv", "--no-renames", "HEAD", ...suffix], limits.maxTrackedDiffBytes),
    ]);
    const first = await capture();
    if (first.some((result) => !result.ok)) {
      return unknownFingerprint(normalizedPaths, ["one or more fingerprint Git sensors are unavailable"], options.configDigest);
    }
    const [headResult, statusResult, nameStatusResult, numstatResult, trackedDiffResult] = first;
    const head = headResult.stdout.toString("utf8").replace(/\r?\n$/, "").toLowerCase();
    if (!/^[0-9a-f]{40,64}$/.test(head)) {
      return unknownFingerprint(normalizedPaths, ["Git HEAD identity is invalid"], options.configDigest);
    }
    const parsedStatus = parsePorcelainStatus(statusResult.stdout, limits);
    if (
      parsedStatus === null ||
      parseNameStatus(nameStatusResult.stdout, limits) === null ||
      parseNumstat(numstatResult.stdout, limits) === null
    ) {
      return unknownFingerprint(normalizedPaths, ["fingerprint Git evidence is malformed or bounded"], options.configDigest);
    }

    const untrackedEvidence: Array<{ path: string; kind: string; digest: string; bytes: number }> = [];
    let untrackedBytes = 0;
    for (const path of sortedUnique(parsedStatus.untracked)) {
      const inspected = await inspectUntracked(canonicalRoot, path, limits.maxUntrackedFileBytes);
      untrackedBytes += inspected.bytes;
      if (
        !inspected.ok ||
        inspected.digest === undefined ||
        inspected.kind === undefined ||
        untrackedBytes > limits.maxUntrackedBytes
      ) {
        return unknownFingerprint(
          normalizedPaths,
          [`untracked fingerprint evidence unavailable for ${path}`],
          options.configDigest,
        );
      }
      untrackedEvidence.push({
        path,
        kind: inspected.kind,
        digest: inspected.digest,
        bytes: inspected.bytes,
      });
    }

    const finalStatus = await runGit(
      canonicalRoot,
      ["status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames", ...suffix],
      limits.maxGitOutputBytes,
    );
    const finalDiff = await runGit(
      canonicalRoot,
      ["diff", "--binary", "--no-ext-diff", "--no-textconv", "--no-renames", "HEAD", ...suffix],
      limits.maxTrackedDiffBytes,
    );
    const finalHead = await runGit(canonicalRoot, ["rev-parse", "--verify", "HEAD"], limits.maxGitOutputBytes);
    const finalParsedStatus = finalStatus.ok ? parsePorcelainStatus(finalStatus.stdout, limits) : null;
    const finalUntrackedPaths = finalParsedStatus === null
      ? null
      : sortedUnique(finalParsedStatus.untracked);
    if (
      !finalStatus.ok ||
      !finalDiff.ok ||
      !finalHead.ok ||
      !finalStatus.stdout.equals(statusResult.stdout) ||
      !finalDiff.stdout.equals(trackedDiffResult.stdout) ||
      !finalHead.stdout.equals(headResult.stdout) ||
      finalUntrackedPaths === null ||
      finalUntrackedPaths.length !== untrackedEvidence.length ||
      finalUntrackedPaths.some((path, index) => path !== untrackedEvidence[index]?.path)
    ) {
      return unknownFingerprint(normalizedPaths, ["repository changed while fingerprinting"], options.configDigest);
    }

    for (const evidence of untrackedEvidence) {
      const reinspected = await inspectUntracked(canonicalRoot, evidence.path, limits.maxUntrackedFileBytes);
      if (
        !reinspected.ok ||
        reinspected.kind !== evidence.kind ||
        reinspected.bytes !== evidence.bytes ||
        reinspected.digest !== evidence.digest
      ) {
        return unknownFingerprint(
          normalizedPaths,
          [`untracked content changed while fingerprinting: ${evidence.path}`],
          options.configDigest,
        );
      }
    }

    const hash = createHash("sha256");
    let bytesHashed = 0;
    bytesHashed += updateFramed(hash, "version", "quality-governor-repository-fingerprint-v1");
    bytesHashed += updateFramed(hash, "root", canonicalRoot);
    bytesHashed += updateFramed(hash, "head", head);
    bytesHashed += updateFramed(hash, "selected-paths", normalizedPaths.join("\0"));
    bytesHashed += updateFramed(hash, "status", statusResult.stdout);
    bytesHashed += updateFramed(hash, "name-status", nameStatusResult.stdout);
    bytesHashed += updateFramed(hash, "numstat", numstatResult.stdout);
    bytesHashed += updateFramed(hash, "tracked-diff", trackedDiffResult.stdout);
    if (options.configDigest !== undefined) {
      bytesHashed += updateFramed(hash, "config", options.configDigest);
    }
    for (const evidence of untrackedEvidence) {
      bytesHashed += updateFramed(hash, "untracked-path", evidence.path);
      bytesHashed += updateFramed(hash, "untracked-kind", evidence.kind);
      bytesHashed += updateFramed(hash, "untracked-size", String(evidence.bytes));
      bytesHashed += updateFramed(hash, "untracked-content", evidence.digest);
      bytesHashed += evidence.bytes;
    }
    return {
      version: 1,
      state: "CURRENT",
      complete: true,
      digest: hash.digest("hex"),
      canonicalRoot,
      head,
      selectedPaths: normalizedPaths,
      ...(options.configDigest === undefined ? {} : { configDigest: options.configDigest }),
      bytesHashed,
      unavailable: [],
    };
  } catch (error) {
    return unknownFingerprint(
      normalizedPaths,
      [`repository fingerprint unavailable: ${failureReason(error)}`],
      options.configDigest,
    );
  }
}

const CHECK_ID_RE = /^[a-z][a-z0-9._-]{0,63}$/;
const HEX_DIGEST_RE = /^[0-9a-f]{64}$/;
const SHELL_META_RE = /[\0\r\n;&|`<>$]/;
const ARG_WILDCARD_RE = /[*?\[\]{}]/;
const RECIPE_KEYS = [
  "id",
  "version",
  "executable",
  "argv",
  "cwd",
  "timeoutMs",
  "outputCap",
  "acceptedExits",
  "checkedPaths",
  "applicability",
  "dimension",
  "recipeDigest",
  "configDigest",
] as const;
const CONFIG_RECIPE_KEYS = [
  "id",
  "version",
  "executable",
  "argv",
  "cwd",
  "timeoutMs",
  "outputCap",
  "acceptedExits",
  "checkedPaths",
  "applicability",
  "dimension",
] as const;

type NormalizedRecipe = Required<Omit<CheckRecipe, "configDigest">> & {
  readonly configDigest?: string;
};

type RecipeResult =
  | { readonly ok: true; readonly value: NormalizedRecipe }
  | { readonly ok: false; readonly reason: string };

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function hasExactKeys(record: Record<string, unknown>, keys: readonly string[]): boolean {
  const ownKeys = Reflect.ownKeys(record);
  if (ownKeys.length !== keys.length || ownKeys.some((key) => typeof key !== "string")) return false;
  const allowed = new Set(keys);
  return ownKeys.every((key) => typeof key === "string" && allowed.has(key));
}

function recipeCwdIsValid(cwd: unknown, allowAbsolute: boolean): cwd is string {
  if (
    typeof cwd !== "string" ||
    cwd.length === 0 ||
    cwd !== cwd.trim() ||
    utf8Length(cwd) > PATH_MAX_BYTES ||
    cwd.includes("\0") ||
    cwd.includes("\\") ||
    WILDCARD_RE.test(cwd)
  ) {
    return false;
  }
  if (cwd === ".") return true;
  if (isAbsolute(cwd)) {
    if (!allowAbsolute || cwd.endsWith("/")) return false;
    const segments = cwd.split("/").slice(1);
    return !segments.some((segment) => segment.length === 0 || segment === "." || segment === "..");
  }
  return parseRepositoryPath(cwd, false) !== null;
}

function recipeIdentity(recipe: {
  readonly id: string;
  readonly version: 1;
  readonly executable: string;
  readonly argv: readonly string[];
  readonly cwd: string;
  readonly timeoutMs: number;
  readonly outputCap: number;
  readonly acceptedExits: readonly number[];
  readonly checkedPaths: readonly string[];
  readonly applicability: string;
  readonly dimension: string;
}): string {
  return sha256(JSON.stringify({
    id: recipe.id,
    version: recipe.version,
    executable: recipe.executable,
    argv: recipe.argv,
    cwd: recipe.cwd,
    timeoutMs: recipe.timeoutMs,
    outputCap: recipe.outputCap,
    acceptedExits: recipe.acceptedExits,
    checkedPaths: recipe.checkedPaths,
    applicability: recipe.applicability,
    dimension: recipe.dimension,
  }));
}

function normalizeRecipe(
  input: unknown,
  options: {
    readonly requireComplete: boolean;
    readonly allowAbsoluteCwd: boolean;
    readonly limits: GovernorConfig["limits"];
  },
): RecipeResult {
  if (!isRecord(input)) return { ok: false, reason: "recipe must be an object" };
  const allowedKeys = options.requireComplete ? CONFIG_RECIPE_KEYS : RECIPE_KEYS;
  if (options.requireComplete ? !hasExactKeys(input, allowedKeys) : Object.keys(input).some((key) => !allowedKeys.includes(key as never))) {
    return { ok: false, reason: "recipe fields are invalid" };
  }

  if (typeof input.id !== "string" || !CHECK_ID_RE.test(input.id)) {
    return { ok: false, reason: "recipe ID is invalid" };
  }
  const version = input.version === undefined && !options.requireComplete ? 1 : input.version;
  if (version !== 1 || (input.executable !== "node" && input.executable !== "git")) {
    return { ok: false, reason: "recipe version or executable is unsupported" };
  }
  if (!Array.isArray(input.argv) || input.argv.length === 0 || input.argv.length > 64) {
    return { ok: false, reason: "recipe argv is invalid" };
  }
  const argv: string[] = [];
  for (const argument of input.argv) {
    if (
      typeof argument !== "string" ||
      argument.length === 0 ||
      argument !== argument.trim() ||
      utf8Length(argument) > 512 ||
      SHELL_META_RE.test(argument) ||
      ARG_WILDCARD_RE.test(argument)
    ) {
      return { ok: false, reason: "recipe argv contains an unsupported value" };
    }
    if (isAbsolute(argument) || /^[A-Za-z]:/.test(argument) || argument.includes("\\")) {
      return { ok: false, reason: "recipe argv contains an absolute or platform-specific path" };
    }
    const argumentSegments = argument.split("/");
    if (argumentSegments.some((segment) => segment === "..")) {
      return { ok: false, reason: "recipe argv contains traversal" };
    }
    argv.push(argument);
  }
  if (input.executable === "git" && !["diff", "status", "rev-parse"].includes(argv[0] ?? "")) {
    return { ok: false, reason: "Git recipe is not read-only" };
  }
  if (
    input.executable === "node" &&
    argv.some((argument) => ["-e", "--eval", "-p", "--print", "-"].includes(argument))
  ) {
    return { ok: false, reason: "Node eval and stdin recipes are unavailable" };
  }
  if (!recipeCwdIsValid(input.cwd, options.allowAbsoluteCwd)) {
    return { ok: false, reason: "recipe cwd is invalid" };
  }

  const timeoutMs = input.timeoutMs === undefined && !options.requireComplete ? 30_000 : input.timeoutMs;
  if (!validPositiveBound(timeoutMs, options.limits.maxCheckTimeoutMs)) {
    return { ok: false, reason: "recipe timeout is invalid" };
  }
  if (!validPositiveBound(input.outputCap, options.limits.maxCheckOutputBytes)) {
    return { ok: false, reason: "recipe output cap is invalid" };
  }
  if (!Array.isArray(input.acceptedExits) || input.acceptedExits.length === 0 || input.acceptedExits.length > 16) {
    return { ok: false, reason: "accepted exits are invalid" };
  }
  const acceptedExits: number[] = [];
  const exitSet = new Set<number>();
  for (const value of input.acceptedExits) {
    if (!Number.isSafeInteger(value) || (value as number) < 0 || (value as number) > 255 || exitSet.has(value as number)) {
      return { ok: false, reason: "accepted exits are invalid or duplicated" };
    }
    exitSet.add(value as number);
    acceptedExits.push(value as number);
  }
  acceptedExits.sort((left, right) => left - right);

  const rawCheckedPaths = input.checkedPaths === undefined && !options.requireComplete ? [] : input.checkedPaths;
  const checkedPaths = validatePathRules(
    Array.isArray(rawCheckedPaths) ? rawCheckedPaths as string[] : undefined,
    options.limits.maxPaths,
    options.limits.maxPathBytes,
  );
  if (checkedPaths === null || (options.requireComplete && checkedPaths.length === 0)) {
    return { ok: false, reason: "recipe checked paths are invalid" };
  }
  const applicability = input.applicability === undefined && !options.requireComplete
    ? "always"
    : input.applicability;
  const dimension = input.dimension === undefined && !options.requireComplete
    ? "verification"
    : input.dimension;
  if (!(["always", "changed-paths", "public-api", "architecture"] as unknown[]).includes(applicability)) {
    return { ok: false, reason: "recipe applicability is invalid" };
  }
  if (!(["verification", "publicApi", "architecture"] as unknown[]).includes(dimension)) {
    return { ok: false, reason: "recipe dimension is invalid" };
  }
  if (
    (dimension === "publicApi" && applicability !== "public-api") ||
    (dimension === "architecture" && applicability !== "architecture") ||
    (dimension === "verification" && (applicability === "public-api" || applicability === "architecture"))
  ) {
    return { ok: false, reason: "recipe applicability does not match its dimension" };
  }

  const identityInput = {
    id: input.id,
    version: 1 as const,
    executable: input.executable,
    argv,
    cwd: input.cwd,
    timeoutMs: timeoutMs as number,
    outputCap: input.outputCap as number,
    acceptedExits,
    checkedPaths,
    applicability: applicability as NormalizedRecipe["applicability"],
    dimension: dimension as NormalizedRecipe["dimension"],
  };
  const digest = recipeIdentity(identityInput);
  if (input.recipeDigest !== undefined && (input.recipeDigest !== digest || !HEX_DIGEST_RE.test(input.recipeDigest as string))) {
    return { ok: false, reason: "recipe digest does not match its identity" };
  }
  if (input.configDigest !== undefined && (typeof input.configDigest !== "string" || !HEX_DIGEST_RE.test(input.configDigest))) {
    return { ok: false, reason: "recipe configuration digest is invalid" };
  }
  const value: NormalizedRecipe = Object.freeze({
    ...identityInput,
    argv: Object.freeze(argv),
    acceptedExits: Object.freeze(acceptedExits),
    checkedPaths: Object.freeze(checkedPaths),
    recipeDigest: digest,
    ...(typeof input.configDigest === "string" ? { configDigest: input.configDigest } : {}),
  });
  return { ok: true, value };
}

/** Resolve one exact, validated recipe ID. Invalid and undeclared recipes are unavailable. */
export function resolveCheckRecipe(
  recipes: readonly CheckRecipe[],
  id: string,
):
  | { readonly ok: true; readonly value: CheckRecipe }
  | { readonly ok: false; readonly code: "QG-011"; readonly reason: string } {
  if (!Array.isArray(recipes) || recipes.length > 128 || typeof id !== "string" || !CHECK_ID_RE.test(id)) {
    return { ok: false, code: "QG-011", reason: "check ID or recipe list is invalid" };
  }
  const seen = new Set<string>();
  let found: NormalizedRecipe | undefined;
  for (const recipe of recipes) {
    const parsed = normalizeRecipe(recipe, {
      requireComplete: false,
      allowAbsoluteCwd: true,
      limits: DEFAULT_LIMITS,
    });
    if (!parsed.ok || seen.has(isRecord(recipe) && typeof recipe.id === "string" ? recipe.id : "")) {
      return { ok: false, code: "QG-011", reason: "recipe list contains an invalid or duplicate recipe" };
    }
    seen.add(parsed.value.id);
    if (parsed.value.id === id) found = parsed.value;
  }
  if (found === undefined) {
    return { ok: false, code: "QG-011", reason: "check ID is not declared by trusted configuration" };
  }
  return { ok: true, value: found };
}

function revisionIsValid(value: unknown, allowZero: boolean): value is number {
  return Number.isSafeInteger(value) && (value as number) >= (allowZero ? 0 : 1);
}

function normalizedReceiptPaths(paths: unknown): string[] | null {
  return validatePathRules(
    Array.isArray(paths) ? paths as string[] : undefined,
    DEFAULT_LIMITS.maxPaths,
    DEFAULT_LIMITS.maxPathBytes,
  );
}

function sameStrings(left: readonly string[], right: readonly string[]): boolean {
  return left.length === right.length && left.every((value, index) => value === right[index]);
}

function invalidReceipt(
  recipeId: string,
  options: {
    readonly contractRevision: number;
    readonly mutationRevision: number;
    readonly checkedPaths: readonly string[];
    readonly fingerprint: string;
  },
  reason: string,
): CheckReceipt {
  return {
    state: "UNKNOWN",
    code: "QG-011",
    reason: reason.slice(0, 256),
    contractRevision: options.contractRevision,
    mutationRevision: options.mutationRevision,
    recipeId,
    checkedPaths: normalizedReceiptPaths(options.checkedPaths) ?? [],
    fingerprint: typeof options.fingerprint === "string" ? options.fingerprint : "",
  };
}

function redactExcerpt(value: string): string {
  return value
    .replace(/\b(authorization)\s*:\s*bearer\s+\S+/gi, "$1: [REDACTED]")
    .replace(/\b(password|token|api[_-]?key|secret)\s*[:=]\s*\S+/gi, "$1=[REDACTED]");
}

function byteBoundedText(value: string, maximumBytes: number): { text: string; truncated: boolean } {
  const redacted = redactExcerpt(value);
  const bytes = Buffer.from(redacted, "utf8");
  if (bytes.length <= maximumBytes) return { text: redacted, truncated: false };
  const marker = Buffer.from("\n…\n", "utf8");
  const available = Math.max(0, maximumBytes - marker.length);
  const headBytes = Math.ceil(available / 2);
  const tailBytes = Math.floor(available / 2);
  const excerpt = Buffer.concat([
    bytes.subarray(0, headBytes),
    marker,
    bytes.subarray(bytes.length - tailBytes),
  ]).toString("utf8");
  const finalBytes = Buffer.from(excerpt, "utf8");
  return {
    text: finalBytes.length <= maximumBytes
      ? excerpt
      : finalBytes.subarray(0, maximumBytes).toString("utf8"),
    truncated: true,
  };
}

function snapshotDigest(value: unknown): string | null {
  if (typeof value === "string") return value.length > 0 && value.length <= 256 && !value.includes("\0") ? value : null;
  if (!isRecord(value)) return null;
  if (value.complete !== true || value.state !== "CURRENT") return null;
  return typeof value.digest === "string" && value.digest.length > 0 && value.digest.length <= 256
    ? value.digest
    : null;
}

interface InjectedRunnerRequest {
  readonly executable: string;
  readonly argv: string[];
  readonly shell: false;
  readonly cwd?: string;
  readonly timeoutMs?: number;
  readonly outputCap?: number;
  readonly signal?: AbortSignal;
}

type InjectedRunner = (request: InjectedRunnerRequest) => Promise<unknown>;

async function runBoundedInjectedRunner(
  runner: InjectedRunner,
  request: InjectedRunnerRequest,
  timeoutMs: number,
  externalSignal?: AbortSignal,
): Promise<unknown> {
  const controller = new AbortController();
  Object.defineProperty(request, "signal", { value: controller.signal, enumerable: false });
  const unavailable = (timedOut: boolean, cancelled: boolean, error?: unknown) => ({
    exitCode: null,
    stdout: "",
    stderr: "",
    timedOut,
    cancelled,
    unknown: true,
    ...(error === undefined ? {} : { spawnError: failureReason(error) }),
  });

  if (externalSignal?.aborted) {
    controller.abort();
    return unavailable(false, true);
  }

  let timeout: ReturnType<typeof setTimeout> | undefined;
  const timeoutOutcome = new Promise<unknown>((resolveOutcome) => {
    timeout = setTimeout(() => {
      controller.abort();
      resolveOutcome(unavailable(true, false));
    }, timeoutMs);
  });
  let onAbort: (() => void) | undefined;
  const cancellationOutcome = externalSignal === undefined
    ? new Promise<never>(() => {})
    : new Promise<unknown>((resolveOutcome) => {
        onAbort = () => {
          controller.abort();
          resolveOutcome(unavailable(false, true));
        };
        externalSignal.addEventListener("abort", onAbort, { once: true });
      });
  const runnerOutcome = Promise.resolve()
    .then(() => runner(request))
    .catch((error: unknown) => unavailable(false, false, error));

  try {
    return await Promise.race([runnerOutcome, timeoutOutcome, cancellationOutcome]);
  } finally {
    if (timeout !== undefined) clearTimeout(timeout);
    if (onAbort !== undefined) externalSignal?.removeEventListener("abort", onAbort);
  }
}

async function boundedRecipeCwd(
  recipe: NormalizedRecipe,
  repositoryRoot: string | undefined,
): Promise<{ readonly ok: true; readonly cwd: string; readonly root: string } | { readonly ok: false }> {
  try {
    if (repositoryRoot !== undefined) {
      const root = await realpath(repositoryRoot);
      if (!(await stat(root)).isDirectory()) return { ok: false };
      const topLevel = await runGit(root, ["rev-parse", "--show-toplevel"], DEFAULT_LIMITS.maxGitOutputBytes);
      if (!topLevel.ok) return { ok: false };
      const reportedRoot = await realpath(topLevel.stdout.toString("utf8").replace(/\r?\n$/, ""));
      if (reportedRoot !== root) return { ok: false };
      const lexical = recipe.cwd === "."
        ? root
        : isAbsolute(recipe.cwd)
          ? recipe.cwd
          : resolve(root, ...recipe.cwd.split("/"));
      const cwd = await realpath(lexical);
      if (!(await stat(cwd)).isDirectory() || !isWithinRoot(root, cwd, true)) return { ok: false };
      return { ok: true, cwd, root };
    }

    const lexical = recipe.cwd === "."
      ? process.cwd()
      : isAbsolute(recipe.cwd)
        ? recipe.cwd
        : resolve(process.cwd(), ...recipe.cwd.split("/"));
    const cwd = await realpath(lexical);
    if (!(await stat(cwd)).isDirectory()) return { ok: false };
    const topLevel = await runGit(cwd, ["rev-parse", "--show-toplevel"], DEFAULT_LIMITS.maxGitOutputBytes);
    if (!topLevel.ok) return { ok: false };
    const root = await realpath(topLevel.stdout.toString("utf8").replace(/\r?\n$/, ""));
    if (!isWithinRoot(root, cwd, true)) return { ok: false };
    return { ok: true, cwd, root };
  } catch {
    return { ok: false };
  }
}

/** Execute one validated executable/argv recipe and bind a bounded freshness receipt. */
export async function runCheckRecipe(
  recipe: CheckRecipe,
  options: {
    readonly contractRevision: number;
    readonly mutationRevision: number;
    readonly checkedPaths: readonly string[];
    readonly fingerprint: string;
    readonly repositoryRoot?: string;
    readonly configDigest?: string;
    readonly signal?: AbortSignal;
    readonly runner?: InjectedRunner;
    readonly snapshot?: () => Promise<string | RepositoryFingerprint>;
    readonly broadSnapshot?: () => Promise<string | RepositoryFingerprint>;
  },
): Promise<CheckReceipt> {
  const recipeId = isRecord(recipe) && typeof recipe.id === "string" ? recipe.id : "unknown";
  if (
    !revisionIsValid(options?.contractRevision, false) ||
    !revisionIsValid(options?.mutationRevision, true) ||
    typeof options?.fingerprint !== "string" ||
    options.fingerprint.length === 0 ||
    options.fingerprint.length > 256 ||
    options.fingerprint.includes("\0")
  ) {
    return invalidReceipt(recipeId, options, "check revision or fingerprint input is invalid");
  }
  const parsedRecipe = normalizeRecipe(recipe, {
    requireComplete: false,
    allowAbsoluteCwd: true,
    limits: DEFAULT_LIMITS,
  });
  const checkedPaths = normalizedReceiptPaths(options.checkedPaths);
  if (!parsedRecipe.ok || checkedPaths === null) {
    return invalidReceipt(recipeId, options, parsedRecipe.ok ? "checked paths are invalid" : parsedRecipe.reason);
  }
  const normalized = parsedRecipe.value;
  if (normalized.checkedPaths.length > 0 && !sameStrings(normalized.checkedPaths, checkedPaths)) {
    return invalidReceipt(recipeId, options, "requested checked paths do not match the declared recipe");
  }
  const effectiveConfigDigest = options.configDigest ?? normalized.configDigest;
  if (
    (options.configDigest !== undefined && !HEX_DIGEST_RE.test(options.configDigest)) ||
    (options.configDigest !== undefined && normalized.configDigest !== undefined && options.configDigest !== normalized.configDigest)
  ) {
    return invalidReceipt(recipeId, options, "configuration identity does not match the recipe");
  }

  if (options.runner !== undefined && options.repositoryRoot === undefined) {
    return invalidReceipt(recipeId, options, "injected runner requires a repository root");
  }
  const executionCwd = await boundedRecipeCwd(normalized, options.repositoryRoot);
  if (!executionCwd.ok) {
    return invalidReceipt(recipeId, options, "recipe cwd is outside the repository or unavailable");
  }

  const takeSnapshot = async (): Promise<string | null> => {
    if (options.snapshot !== undefined) return snapshotDigest(await options.snapshot());
    const fingerprint = await fingerprintRepository(executionCwd.root, checkedPaths, {
      ...(effectiveConfigDigest === undefined ? {} : { configDigest: effectiveConfigDigest }),
    });
    return fingerprint.complete ? fingerprint.digest : null;
  };

  let preFingerprint: string | null;
  try {
    preFingerprint = await takeSnapshot();
  } catch {
    preFingerprint = null;
  }
  if (preFingerprint === null) {
    return invalidReceipt(recipeId, options, "pre-check repository fingerprint is unavailable");
  }
  if (preFingerprint !== options.fingerprint) {
    return {
      state: "STALE",
      code: "QG-013",
      reason: "repository state changed before check execution",
      contractRevision: options.contractRevision,
      mutationRevision: options.mutationRevision,
      recipeId: normalized.id,
      recipeVersion: normalized.version,
      recipeDigest: normalized.recipeDigest,
      ...(effectiveConfigDigest === undefined ? {} : { configDigest: effectiveConfigDigest }),
      checkedPaths,
      fingerprint: preFingerprint,
      preFingerprint,
      currentFingerprint: preFingerprint,
    };
  }

  let broadPreFingerprint: string | null = null;
  if (options.broadSnapshot !== undefined) {
    try {
      broadPreFingerprint = snapshotDigest(await options.broadSnapshot());
    } catch {
      broadPreFingerprint = null;
    }
    if (broadPreFingerprint === null) {
      return invalidReceipt(recipeId, options, "broad pre-check repository fingerprint is unavailable");
    }
  }

  let rawOutcome: unknown;
  try {
    if (options.runner !== undefined) {
      const request = {
        executable: normalized.executable,
        argv: [...normalized.argv],
        shell: false as const,
      };
      Object.defineProperties(request, {
        cwd: { value: executionCwd.cwd, enumerable: false },
        timeoutMs: { value: normalized.timeoutMs, enumerable: false },
        outputCap: { value: normalized.outputCap, enumerable: false },
      });
      rawOutcome = await runBoundedInjectedRunner(
        options.runner,
        request,
        normalized.timeoutMs,
        options.signal,
      );
    } else {
      const outcome = await runArgv(normalized.executable, normalized.argv, {
        cwd: executionCwd.cwd,
        timeoutMs: normalized.timeoutMs,
        outputCap: normalized.outputCap,
        ...(options.signal === undefined ? {} : { signal: options.signal }),
      });
      rawOutcome = outcome;
    }
  } catch (error) {
    rawOutcome = {
      exitCode: null,
      stdout: "",
      stderr: "",
      timedOut: false,
      unknown: true,
      spawnError: failureReason(error),
    };
  }

  const outcome = isRecord(rawOutcome) ? rawOutcome : {};
  const stdoutValue = Buffer.isBuffer(outcome.stdout)
    ? outcome.stdout.toString("utf8")
    : typeof outcome.stdout === "string" ? outcome.stdout : "";
  const stderrValue = Buffer.isBuffer(outcome.stderr)
    ? outcome.stderr.toString("utf8")
    : typeof outcome.stderr === "string" ? outcome.stderr : "";
  const outputBytes = utf8Length(stdoutValue) + utf8Length(stderrValue);
  const stdoutExcerpt = byteBoundedText(stdoutValue, Math.ceil(normalized.outputCap / 2));
  const stderrExcerpt = byteBoundedText(stderrValue, Math.floor(normalized.outputCap / 2));
  const digest = typeof outcome.outputDigest === "string" && outcome.outputDigest.length > 0 && outcome.outputDigest.length <= 128
    ? outcome.outputDigest
    : outputDigest(sha256(Buffer.from(stdoutValue)), sha256(Buffer.from(stderrValue)));

  let postFingerprint: string | null;
  try {
    postFingerprint = await takeSnapshot();
  } catch {
    postFingerprint = null;
  }

  let broadPostFingerprint: string | null = null;
  if (options.broadSnapshot !== undefined) {
    try {
      broadPostFingerprint = snapshotDigest(await options.broadSnapshot());
    } catch {
      broadPostFingerprint = null;
    }
  }

  const common = {
    contractRevision: options.contractRevision,
    mutationRevision: options.mutationRevision,
    recipeId: normalized.id,
    recipeVersion: normalized.version,
    recipeDigest: normalized.recipeDigest,
    ...(effectiveConfigDigest === undefined ? {} : { configDigest: effectiveConfigDigest }),
    checkedPaths,
    fingerprint: postFingerprint ?? preFingerprint,
    preFingerprint,
    ...(postFingerprint === null ? {} : { currentFingerprint: postFingerprint }),
    exitCode: typeof outcome.exitCode === "number" || outcome.exitCode === null
      ? outcome.exitCode as number | null
      : null,
    signal: typeof outcome.signal === "string" || outcome.signal === null
      ? outcome.signal as string | null
      : null,
    timedOut: outcome.timedOut === true,
    cancelled: outcome.cancelled === true || options.signal?.aborted === true,
    outputDigest: digest,
    stdoutExcerpt: stdoutExcerpt.text,
    stderrExcerpt: stderrExcerpt.text,
    outputTruncated:
      stdoutExcerpt.truncated ||
      stderrExcerpt.truncated ||
      outputBytes > normalized.outputCap ||
      outcome.overflow === true,
  } satisfies Omit<CheckReceipt, "state" | "code" | "reason">;

  if (postFingerprint === null) {
    return { ...common, state: "UNKNOWN", code: "QG-011", reason: "post-check repository fingerprint is unavailable" };
  }
  if (outcome.repositoryChanged === true || postFingerprint !== preFingerprint) {
    return { ...common, state: "STALE", code: "QG-012", reason: "checker changed repository state" };
  }
  if (options.broadSnapshot !== undefined) {
    if (broadPreFingerprint === null || broadPostFingerprint === null) {
      return { ...common, state: "UNKNOWN", code: "QG-011", reason: "broad mutation fingerprint is unavailable" };
    }
    if (broadPreFingerprint !== broadPostFingerprint) {
      return { ...common, state: "STALE", code: "QG-012", reason: "checker changed governed repository state" };
    }
  }
  const unavailable =
    outcome.unknown === true ||
    outcome.spawnError !== undefined ||
    outcome.timedOut === true ||
    outcome.cancelled === true ||
    options.signal?.aborted === true ||
    outcome.overflow === true ||
    outputBytes > normalized.outputCap ||
    common.signal !== null ||
    common.exitCode === null;
  if (unavailable) {
    return { ...common, state: "UNKNOWN", code: "QG-011", reason: "check execution is incomplete or unavailable" };
  }
  if (!normalized.acceptedExits.includes(common.exitCode as number)) {
    return { ...common, state: "FAILED", code: "QG-011", reason: "check exited with a non-accepted status" };
  }
  return { ...common, state: "CURRENT" };
}

/** Revalidate an existing receipt against exact current identity and freshness evidence. */
export function validateReceiptFreshness(
  receipt: CheckReceipt,
  current: {
    readonly contractRevision: number;
    readonly mutationRevision: number;
    readonly fingerprint: string;
    readonly checkedPaths: readonly string[];
    readonly recipeId: string;
    readonly recipeVersion?: number;
    readonly recipeDigest?: string;
    readonly configDigest?: string;
  },
): CheckReceipt {
  const receiptPaths = normalizedReceiptPaths(receipt?.checkedPaths);
  const currentPaths = normalizedReceiptPaths(current?.checkedPaths);
  const receiptFingerprint = receipt?.currentFingerprint ?? receipt?.fingerprint;
  const identityMismatch =
    !revisionIsValid(receipt?.contractRevision, false) ||
    !revisionIsValid(receipt?.mutationRevision, true) ||
    !revisionIsValid(current?.contractRevision, false) ||
    !revisionIsValid(current?.mutationRevision, true) ||
    receipt.contractRevision !== current.contractRevision ||
    receipt.mutationRevision !== current.mutationRevision ||
    typeof receiptFingerprint !== "string" ||
    receiptFingerprint !== current.fingerprint ||
    receipt.fingerprint !== receiptFingerprint ||
    (receipt.preFingerprint !== undefined && receipt.preFingerprint !== receiptFingerprint) ||
    receipt.code !== undefined ||
    receipt.recipeId !== current.recipeId ||
    (receipt.recipeVersion !== undefined || current.recipeVersion !== undefined
      ? receipt.recipeVersion !== current.recipeVersion
      : false) ||
    receiptPaths === null ||
    currentPaths === null ||
    !sameStrings(receiptPaths ?? [], currentPaths ?? []) ||
    (receipt.recipeDigest !== undefined || current.recipeDigest !== undefined
      ? receipt.recipeDigest !== current.recipeDigest
      : false) ||
    (receipt.configDigest !== undefined || current.configDigest !== undefined
      ? receipt.configDigest !== current.configDigest
      : false);

  if (receipt?.state !== "CURRENT") {
    return {
      ...receipt,
      ...(receiptPaths === null ? {} : { checkedPaths: receiptPaths }),
    };
  }
  if (identityMismatch) {
    return {
      ...receipt,
      state: "STALE",
      code: "QG-013",
      reason: "verification receipt does not match current repository identity",
      ...(receiptPaths === null ? {} : { checkedPaths: receiptPaths }),
    };
  }
  const { code: _code, reason: _reason, ...fresh } = receipt;
  return { ...fresh, state: "CURRENT", checkedPaths: receiptPaths ?? [] };
}

const BUILTIN_PROTECTED_PATHS = Object.freeze([
  "AGENTS.md",
  ".pi/extensions/quality-governor/**",
  ".pi/quality-governor.json",
  ".pi/artifacts/**",
  ".pi/fabric/**",
  ".pi/state/**",
  ".pi/state.md",
  ".pi/prewalk.json",
]);
const BUILTIN_DEPENDENCY_PATHS = Object.freeze([
  "package.json",
  "package-lock.json",
  "npm-shrinkwrap.json",
  "pnpm-lock.yaml",
  "yarn.lock",
  "bun.lock",
  "bun.lockb",
  "deno.json",
  "deno.jsonc",
]);
const BUILTIN_TOOLS = Object.freeze({
  PLAN: Object.freeze(["fabric_exec", "read", "grep", "find", "ls", "quality_contract", "quality_status"]),
  BUILD: Object.freeze(["fabric_exec", "read", "grep", "find", "ls", "edit", "write", "quality_contract", "quality_status", "quality_check"]),
  VERIFY: Object.freeze(["fabric_exec", "read", "grep", "find", "ls", "quality_contract", "quality_status", "quality_check"]),
});

function builtinRecipeInputs(): Array<Record<string, unknown>> {
  const governedPaths = [
    ".pi/extensions/quality-governor/**",
    ".pi/quality-governor.json",
    ".pi/tests/quality-governor.test.ts",
  ];
  return [
    {
      id: "quality-governor-diff-check",
      version: 1,
      executable: "git",
      argv: [
        "diff",
        "--check",
        "--",
        ".pi/extensions/quality-governor/policy.ts",
        ".pi/extensions/quality-governor/sensors.ts",
        ".pi/extensions/quality-governor/index.ts",
        ".pi/quality-governor.json",
        ".pi/tests/quality-governor.test.ts",
      ],
      cwd: ".",
      timeoutMs: 30_000,
      outputCap: 65_536,
      acceptedExits: [0],
      checkedPaths: governedPaths,
      applicability: "always",
      dimension: "verification",
    },
    {
      id: "quality-governor-tests",
      version: 1,
      executable: "node",
      argv: ["--experimental-strip-types", "--test", ".pi/tests/quality-governor.test.ts"],
      cwd: ".",
      timeoutMs: 120_000,
      outputCap: 262_144,
      acceptedExits: [0],
      checkedPaths: governedPaths,
      applicability: "always",
      dimension: "verification",
    },
    {
      id: "typecheck",
      version: 1,
      executable: "node",
      argv: ["--experimental-strip-types", "--check", ".pi/extensions/quality-governor/index.ts"],
      cwd: ".",
      timeoutMs: 30_000,
      outputCap: 65_536,
      acceptedExits: [0],
      checkedPaths: [".pi/extensions/quality-governor/index.ts"],
      applicability: "always",
      dimension: "verification",
    },
  ];
}

function configPayload(
  limits: GovernorConfig["limits"],
  protectedPaths: readonly string[],
  dependencyPaths: readonly string[],
  tools: GovernorConfig["tools"],
  recipes: readonly CheckRecipe[],
): Record<string, unknown> {
  return {
    version: 1,
    enabled: true,
    rollout: "observe",
    maxRepairs: 1,
    limits,
    protectedPaths,
    dependencyPaths,
    tools,
    recipes: recipes.map((recipe) => ({
      id: recipe.id,
      version: recipe.version,
      executable: recipe.executable,
      argv: recipe.argv,
      cwd: recipe.cwd,
      timeoutMs: recipe.timeoutMs,
      outputCap: recipe.outputCap,
      acceptedExits: recipe.acceptedExits,
      checkedPaths: recipe.checkedPaths,
      applicability: recipe.applicability,
      dimension: recipe.dimension,
    })),
  };
}

function freezeConfig(
  source: "built-in" | "project",
  limits: GovernorConfig["limits"],
  protectedPaths: readonly string[],
  dependencyPaths: readonly string[],
  tools: GovernorConfig["tools"],
  recipesWithoutConfigDigest: readonly NormalizedRecipe[],
  issue?: string,
): GovernorConfig {
  const normalizedProtected = [...protectedPaths].sort(compareStrings);
  const normalizedDependencies = [...dependencyPaths].sort(compareStrings);
  const normalizedTools = {
    PLAN: [...tools.PLAN],
    BUILD: [...tools.BUILD],
    VERIFY: [...tools.VERIFY],
  };
  const normalizedRecipes = [...recipesWithoutConfigDigest].sort((left, right) => compareStrings(left.id, right.id));
  const payload = configPayload(
    limits,
    normalizedProtected,
    normalizedDependencies,
    normalizedTools,
    normalizedRecipes,
  );
  const configDigest = sha256(JSON.stringify(payload));
  const recipes = normalizedRecipes.map((recipe) => Object.freeze({
    ...recipe,
    configDigest,
  }));
  return Object.freeze({
    version: 1,
    enabled: true,
    rollout: "observe",
    maxRepairs: 1,
    limits: Object.freeze({ ...limits }),
    protectedPaths: Object.freeze(normalizedProtected),
    dependencyPaths: Object.freeze(normalizedDependencies),
    tools: Object.freeze({
      PLAN: Object.freeze(normalizedTools.PLAN),
      BUILD: Object.freeze(normalizedTools.BUILD),
      VERIFY: Object.freeze(normalizedTools.VERIFY),
    }),
    recipes: Object.freeze(recipes),
    source,
    configDigest,
    ...(issue === undefined ? {} : { code: "QG-015" as const, reason: issue.slice(0, 256) }),
  });
}

function builtinConfig(issue?: string): GovernorConfig {
  const recipes: NormalizedRecipe[] = [];
  for (const input of builtinRecipeInputs()) {
    const parsed = normalizeRecipe(input, {
      requireComplete: true,
      allowAbsoluteCwd: false,
      limits: DEFAULT_LIMITS,
    });
    if (!parsed.ok) {
      throw new TypeError(`invalid built-in quality governor recipe: ${parsed.reason}`);
    }
    recipes.push(parsed.value);
  }
  return freezeConfig(
    "built-in",
    DEFAULT_LIMITS,
    BUILTIN_PROTECTED_PATHS,
    BUILTIN_DEPENDENCY_PATHS,
    BUILTIN_TOOLS,
    recipes,
    issue,
  );
}

function sameSet(values: readonly string[], expected: readonly string[]): boolean {
  return values.length === expected.length && sameStrings([...values].sort(compareStrings), [...expected].sort(compareStrings));
}

async function parseGovernorConfig(input: unknown, root: string): Promise<GovernorConfig | null> {
  if (!isRecord(input) || !hasExactKeys(input, [
    "version",
    "enabled",
    "rollout",
    "maxRepairs",
    "limits",
    "protectedPaths",
    "dependencyPaths",
    "tools",
    "recipes",
  ])) {
    return null;
  }
  if (input.version !== 1 || input.enabled !== true || input.rollout !== "observe" || input.maxRepairs !== 1) {
    return null;
  }
  if (!isRecord(input.limits) || !hasExactKeys(input.limits, Object.keys(DEFAULT_LIMITS))) return null;
  const limits = sensorLimits(input.limits);
  if (limits === null) return null;
  const protectedPaths = validatePathRules(
    Array.isArray(input.protectedPaths) ? input.protectedPaths as string[] : undefined,
    limits.maxPaths,
    limits.maxPathBytes,
  );
  const dependencyPaths = validatePathRules(
    Array.isArray(input.dependencyPaths) ? input.dependencyPaths as string[] : undefined,
    limits.maxPaths,
    limits.maxPathBytes,
  );
  if (
    protectedPaths === null ||
    dependencyPaths === null ||
    !sameSet(protectedPaths, BUILTIN_PROTECTED_PATHS) ||
    !sameSet(dependencyPaths, BUILTIN_DEPENDENCY_PATHS)
  ) {
    return null;
  }

  if (!isRecord(input.tools) || !hasExactKeys(input.tools, ["PLAN", "BUILD", "VERIFY"])) return null;
  const tools: Record<"PLAN" | "BUILD" | "VERIFY", string[]> = { PLAN: [], BUILD: [], VERIFY: [] };
  for (const mode of ["PLAN", "BUILD", "VERIFY"] as const) {
    const values = input.tools[mode];
    if (!Array.isArray(values) || values.length > 32 || values.some((value) => typeof value !== "string" || !CHECK_ID_RE.test(value))) {
      return null;
    }
    const names = values as string[];
    if (new Set(names).size !== names.length || !sameSet(names, BUILTIN_TOOLS[mode])) return null;
    tools[mode] = [...BUILTIN_TOOLS[mode]];
  }

  if (!Array.isArray(input.recipes) || input.recipes.length !== builtinRecipeInputs().length) return null;
  const recipes: NormalizedRecipe[] = [];
  const ids = new Set<string>();
  for (const recipe of input.recipes) {
    const parsed = normalizeRecipe(recipe, {
      requireComplete: true,
      allowAbsoluteCwd: false,
      limits,
    });
    if (!parsed.ok || ids.has(parsed.ok ? parsed.value.id : "")) return null;
    ids.add(parsed.value.id);
    const lexicalCwd = parsed.value.cwd === "." ? root : resolve(root, ...parsed.value.cwd.split("/"));
    try {
      const cwd = await realpath(lexicalCwd);
      if (!(await stat(cwd)).isDirectory() || !isWithinRoot(root, cwd, true)) return null;
    } catch {
      return null;
    }
    recipes.push(parsed.value);
  }
  if (!sameSet([...ids], builtinRecipeInputs().map((recipe) => String(recipe.id)))) return null;
  recipes.sort((left, right) => compareStrings(left.id, right.id));
  return freezeConfig(
    "project",
    limits,
    protectedPaths,
    dependencyPaths,
    tools,
    recipes,
  );
}

async function configuredDirectoryName(override?: string): Promise<string | null> {
  let directory = override;
  if (directory === undefined) {
    try {
      const module = await import("@earendil-works/pi-coding-agent");
      const candidate = Reflect.get(module, "CONFIG_DIR_NAME");
      if (typeof candidate === "string" && candidate.length > 0) directory = candidate;
    } catch {
      directory = ".pi";
    }
  }
  if (
    typeof directory !== "string" ||
    directory.length === 0 ||
    directory !== directory.trim() ||
    directory.includes("\0") ||
    directory.includes("/") ||
    directory.includes("\\") ||
    directory === "." ||
    directory === ".."
  ) {
    return null;
  }
  return directory;
}

/** Load only trusted, strict version-1 project configuration; otherwise return observe defaults. */
export async function loadGovernorConfig(
  contextOrRoot: string | {
    readonly cwd?: string;
    readonly isProjectTrusted?: () => boolean;
  },
  trustOrOptions?: boolean | {
    readonly trusted?: boolean;
    readonly configDirName?: string;
  },
): Promise<GovernorConfig> {
  const root = typeof contextOrRoot === "string"
    ? contextOrRoot
    : contextOrRoot?.cwd ?? process.cwd();
  let trusted: boolean;
  let directoryOverride: string | undefined;
  if (typeof trustOrOptions === "boolean") {
    trusted = trustOrOptions;
  } else if (trustOrOptions !== undefined) {
    trusted = trustOrOptions.trusted === true;
    directoryOverride = trustOrOptions.configDirName;
  } else if (typeof contextOrRoot === "object" && contextOrRoot !== null && typeof contextOrRoot.isProjectTrusted === "function") {
    try {
      trusted = contextOrRoot.isProjectTrusted() === true;
    } catch {
      trusted = false;
    }
  } else {
    trusted = false;
  }
  if (!trusted) return builtinConfig("project is not trusted; project configuration was not read");

  try {
    const canonicalRoot = await realpath(root);
    if (!(await stat(canonicalRoot)).isDirectory()) return builtinConfig("project root is unavailable");
    const directory = await configuredDirectoryName(directoryOverride);
    if (directory === null) return builtinConfig("configuration directory name is invalid");
    const lexicalPath = join(canonicalRoot, directory, "quality-governor.json");
    const canonicalPath = await realpath(lexicalPath);
    if (!isWithinRoot(canonicalRoot, canonicalPath, false)) {
      return builtinConfig("configuration file escapes the project root");
    }
    const fileStat = await stat(canonicalPath);
    if (!fileStat.isFile() || fileStat.size > 256 * 1024) {
      return builtinConfig("configuration file is unavailable or exceeds its bound");
    }
    const raw = await readFile(canonicalPath, "utf8");
    if (utf8Length(raw) > 256 * 1024) return builtinConfig("configuration file exceeds its bound");
    const parsed = await parseGovernorConfig(JSON.parse(raw) as unknown, canonicalRoot);
    return parsed ?? builtinConfig("configuration is malformed or weakens required invariants");
  } catch {
    return builtinConfig("configuration is unreadable or malformed");
  }
}