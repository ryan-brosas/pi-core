{
  "version": 1,
  "enabled": true,
  "rollout": "observe",
  "maxRepairs": 1,
  "limits": {
    "maxPaths": 4096,
    "maxPathBytes": 1024,
    "maxGitOutputBytes": 1048576,
    "maxTrackedDiffBytes": 4194304,
    "maxUntrackedFileBytes": 1048576,
    "maxUntrackedBytes": 4194304,
    "maxCheckOutputBytes": 262144,
    "maxCheckTimeoutMs": 120000
  },
  "protectedPaths": [
    "AGENTS.md",
    ".pi/extensions/quality-governor/**",
    ".pi/quality-governor.json",
    ".pi/artifacts/**",
    ".pi/fabric/**",
    ".pi/state/**",
    ".pi/state.md",
    ".pi/prewalk.json"
  ],
  "dependencyPaths": [
    "package.json",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "deno.json",
    "deno.jsonc"
  ],
  "tools": {
    "PLAN": [
      "fabric_exec",
      "read",
      "grep",
      "find",
      "ls",
      "quality_contract",
      "quality_status"
    ],
    "BUILD": [
      "fabric_exec",
      "read",
      "grep",
      "find",
      "ls",
      "edit",
      "write",
      "quality_contract",
      "quality_status",
      "quality_check"
    ],
    "VERIFY": [
      "fabric_exec",
      "read",
      "grep",
      "find",
      "ls",
      "quality_contract",
      "quality_status",
      "quality_check"
    ]
  },
  "recipes": [
    {
      "id": "quality-governor-diff-check",
      "version": 1,
      "executable": "git",
      "argv": [
        "diff",
        "--check",
        "--",
        ".pi/extensions/quality-governor/policy.ts",
        ".pi/extensions/quality-governor/sensors.ts",
        ".pi/extensions/quality-governor/index.ts",
        ".pi/quality-governor.json",
        ".pi/tests/quality-governor.test.ts"
      ],
      "cwd": ".",
      "timeoutMs": 30000,
      "outputCap": 65536,
      "acceptedExits": [0],
      "checkedPaths": [
        ".pi/extensions/quality-governor/**",
        ".pi/quality-governor.json",
        ".pi/tests/quality-governor.test.ts"
      ],
      "applicability": "always",
      "dimension": "verification"
    },
    {
      "id": "quality-governor-tests",
      "version": 1,
      "executable": "node",
      "argv": [
        "--experimental-strip-types",
        "--test",
        ".pi/tests/quality-governor.test.ts"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "outputCap": 262144,
      "acceptedExits": [0],
      "checkedPaths": [
        ".pi/extensions/quality-governor/**",
        ".pi/quality-governor.json",
        ".pi/tests/quality-governor.test.ts"
      ],
      "applicability": "always",
      "dimension": "verification"
    },
    {
      "id": "typecheck",
      "version": 1,
      "executable": "node",
      "argv": [
        "--experimental-strip-types",
        "--check",
        ".pi/extensions/quality-governor/index.ts"
      ],
      "cwd": ".",
      "timeoutMs": 30000,
      "outputCap": 65536,
      "acceptedExits": [0],
      "checkedPaths": [
        ".pi/extensions/quality-governor/index.ts"
      ],
      "applicability": "always",
      "dimension": "verification"
    }
  ]
}