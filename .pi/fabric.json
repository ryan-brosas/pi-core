{
  "configVersion": 1,
  "executor": {
    "runtime": "quickjs",
    "memoryLimitBytes": 1073741824
  },
  "agents": {
    "enabled": true,
    "notifyOnComplete": false,
    "transport": "auto",
    "maxConcurrent": 1,
    "maxPerExecution": 1,
    "thinking": "max",
    "maxDepth": 1,
    "budgetUsd": 25,
    "maxTokensPerChild": 100000
  },
  "ui": {
    "widget": "hidden",
    "enabled": true
  },
  "compaction": {
    "engine": "pi",
    "targetContextRatio": 0.7
  },
  "mesh": {
    "enabled": true
  },
  "fullCodeMode": true,
  "capture": {
    "keepVisible": [
      "fabric_exec"
    ]
  },
  "prewalk": {
    "alwaysRearm": false,
    "mode": "in-place",
    "model": ""
  }
}
