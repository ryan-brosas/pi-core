{
  "configVersion": 1,
  "executor": {
    "runtime": "node-process"
  },
  "agents": {
    "enabled": true,
    "runner": "pi",
    "extensions": true,
    "retainRuns": false,
    "notifyOnComplete": false,
    "transport": "process",
    "timeoutMs": 600000,
    "maxConcurrent": 4,
    "maxPerExecution": 8,
    "maxDepth": 2,
    "maxTokensPerChild": 0
  },
  "ui": {
    "widget": "auto",
    "enabled": false
  },
  "compaction": {
    "engine": "pi",
    "targetContextRatio": 0.7
  },
  "mesh": {
    "enabled": true,
    "actorScope": "project",
    "root": "/tmp/pi-core-fabric-smoke.pFAs1u/mesh",
    "actorQueueLimit": 16
  },
  "fullCodeMode": true,
  "capture": {
    "keepVisible": [
      "fabric_exec",
      "Agent",
      "get_subagent_result",
      "steer_subagent"
    ]
  },
  "prewalk": {
    "alwaysRearm": true,
    "model": "makora/zai-org/GLM-5.2-NVFP4"
  }
}
